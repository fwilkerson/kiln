A spec's build stops, since its gate fails until the developer's kiln tend session sees to it. Meanwhile the
developer commits a z.go of their own on main. Once the session exits, kiln merges main into the work, and sends the
conflict to the build session, as a round. It resumes the build session with the session's note, and the build lands.

-- .kiln/kiln.json --
{"gate": ["test -e \"$WORK/.tmp/tended\""]}
-- .kiln/specs/z.md --
### 1. Z answers

- **Given**: nothing.
- **When**: Z is called.
- **Then**: it answers 9.
-- _given/z/z.go --
// Package scratch is where kiln's builds land.
package scratch

// Z answers 9.
func Z() int { return 9 }
-- _given/steps.json --
{
 "build": [
  {"tool": {"name": "Bash", "input": {"command": "if git merge-base --is-ancestor main HEAD; then cp -R \"$WORK/_given/z/.\" .; else git merge main >/dev/null 2>&1; cp -R \"$WORK/_given/z/.\" . && git add -A && git commit -qm 'merge main' >/dev/null; fi; true"}}},
  {"result": {"result": "Built z."}}
 ],
 "tend": [
  {"tool": {"name": "Bash", "input": {"command": "for p in \"$WORK\"/.claude-calls/tend/*/*/prompt; do n=$(sed -n 's/^A note for the build: //p' \"$p\"); [ -z \"$n\" ] || echo 'The gate wanted .tmp/tended.' >\"$n\"; done; touch \"$WORK/.tmp/tended\""}}},
  {"exit": 0}
 ],
 "audit": [
  {"tool": {"name": "Bash", "input": {"command": "echo stray >audit-stray.txt"}}},
  {"result": {"audit": {"read": 1}}}
 ]
}
