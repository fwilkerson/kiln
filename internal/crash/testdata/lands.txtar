A spec's build lands on main, and waits for UAT.

-- .kiln/kiln.json --
{"gate": ["true"]}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/steps.json --
{
 "build": [
  {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
  {"result": {"result": "Built x."}}
 ],
 "audit": [
  {"tool": {"name": "Bash", "input": {"command": "echo stray >audit-stray.txt"}}},
  {"result": {"audit": {"read": 1}}}
 ]
}
