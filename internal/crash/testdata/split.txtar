A spec's build in build-and-verify runs its two sessions at once, and lands on main.

-- .kiln/kiln.json --
{"gate": ["true"], "workflow": "build-and-verify", "acceptanceTests": "acceptance/{spec}/"}
-- .kiln/specs/v.md --
### 1. V answers

- **Given**: nothing.
- **When**: V is called.
- **Then**: it answers 5.
-- _given/code/v.go --
// Package scratch is where kiln's builds land.
package scratch

// V answers 5.
func V() int { return 5 }
-- _given/tests/acceptance/v/v.txt --
V answers 5.
-- _given/steps.json --
{
 "build": [
  {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/code/.\" ."}}},
  {"result": {"result": "Built v."}}
 ],
 "verify": [
  {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests/.\" ."}}},
  {"result": {"result": "Wrote the tests of v."}}
 ],
 "audit": [
  {"tool": {"name": "Bash", "input": {"command": "echo stray >audit-stray.txt"}}},
  {"result": {"audit": {"read": 2}}}
 ]
}
