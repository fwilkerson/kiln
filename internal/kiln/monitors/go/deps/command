#!/bin/sh
# The command of the deps monitor, for a Go project. It requires each update the check finds, as lib/updates says,
# then tidies go.mod and go.sum. It vendors the modules again where the project vendors them.
#
# An update can add a module that has an update of its own, so it searches again until it finds none. It stops when a
# search finds what the last one did, since go get then could not require it, and the gate's check says which.
set -eu

dir=$(dirname "$0")
last=
updates=$(sh "$dir/lib/updates")
while [ -n "$updates" ] && [ "$updates" != "$last" ]; do
  # shellcheck disable=SC2046 # each update is one argument.
  go get $(printf '%s\n' "$updates" | awk '{ print $1 "@" $3 }')
  go mod tidy
  last=$updates
  updates=$(sh "$dir/lib/updates")
done

[ ! -d vendor ] || go mod vendor
