{
  "gate": [
    "go vet ./...",
    "go test ./..."
  ],
  "rounds": 3,
  "hosts": [
    "proxy.golang.org",
    "sum.golang.org",
    "storage.googleapis.com"
  ],
  "writable": [
    "go env GOCACHE GOMODCACHE",
    "echo \"$(go env GOPATH | cut -d: -f1)/pkg/sumdb\""
  ],
  "acceptance": "acceptance/{spec}/",
  "harness": [
    "internal/testutil/"
  ]
}
