{
  "gate": [
    "uv run ruff check",
    "uv run ty check",
    "uv run pytest ${KILN_JUNIT:+--junitxml=\"$KILN_JUNIT\"} || [ $? -eq 5 ]"
  ],
  "rounds": 3,
  "hosts": [
    "pypi.org",
    "files.pythonhosted.org"
  ],
  "writable": [
    "uv cache dir"
  ],
  "acceptance": "tests/acceptance/test_{spec}.py",
  "harness": [
    "tests/conftest.py",
    "tests/acceptance/conftest.py"
  ]
}
