{
  "$schema": "./generated/kiln.schema.json",
  "gate": [
    "uv run ruff check",
    "uv run ty check",
    "uv run pytest ${KILN_JUNIT:+--junitxml=\"$KILN_JUNIT\"} || [ $? -eq 5 ]"
  ],
  "rounds": 3,
  "allowedHosts": [
    "pypi.org",
    "files.pythonhosted.org"
  ],
  "writablePathCommands": [
    "uv cache dir"
  ],
  "testFiles": [
    "test_*.py",
    "*_test.py",
    "conftest.py",
    "tests"
  ],
  "acceptanceTests": "tests/acceptance/test_{spec}.py"
}
