{
  "$schema": "./generated/kiln.schema.json",
  "gate": [
    "npm ci --no-audit --no-fund",
    "npx --no -- tsc --noEmit",
    "node --test ${KILN_JUNIT:+--test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=\"$KILN_JUNIT\"}"
  ],
  "rounds": 3,
  "allowedHosts": [
    "registry.npmjs.org"
  ],
  "writablePathCommands": [
    "npm config get cache"
  ],
  "acceptanceTests": "tests/acceptance/{spec}.test.ts"
}
