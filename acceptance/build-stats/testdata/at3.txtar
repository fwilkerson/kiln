# 3. Failed calls are grouped by cause.

# Given: a build whose session had two calls refused for the same reason, and two that failed with the same
# message in their output.
# kiln's hook refuses both edits of the spec. Both commands print a style checker's complaint about a different file.
exec kiln approve x
exec kiln run
stdout '^x: landed on main'

# When: the developer runs kiln stats <name>.
exec kiln stats x

# Then: it shows each cause once, with its count, and the input of a call it holds.
stdout '^failed: +4 failed calls$'
stdout '^ +2  refused: PreToolUse:Edit hook error: \S*specs/x.md is under specs/.*\n +Edit: /'
stdout '^ +2  the line is wider than 120 columns\n +Bash: echo ''[ab].go:[37]: the line is wider than 120 columns''; exit 1$'

# The build as a whole names each cause once.
exec sh -c 'kiln stats x | sed "/^$/q" | grep -c "^ *2  the line is wider"'
stdout '^1$'
exec sh -c 'kiln stats x | sed "/^$/q" | grep -c "^ *2  refused: "'
stdout '^1$'

-- go.mod --
module example.com/scratch

go 1.27
-- kiln.json --
{"gate": ["go vet ./...", "go test ./..."], "rounds": 1}
-- specs/x.md --
# Spec 1: x

## Acceptance tests

### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Edit", "input": {"file_path": "specs/x.md", "old_string": "42", "new_string": "41"}}},
    {"tool": {"name": "Bash", "input": {"command": "echo 'a.go:3: the line is wider than 120 columns'; exit 1"}}},
    {"tool": {"name": "Edit", "input": {"file_path": "specs/x.md", "old_string": "X", "new_string": "Y"}}},
    {"tool": {"name": "Bash", "input": {"command": "echo 'b.go:7: the line is wider than 120 columns'; exit 1"}}},
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
    {"result": {"result": "Built x."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"result": "read 2 packages, found 0"}}]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
