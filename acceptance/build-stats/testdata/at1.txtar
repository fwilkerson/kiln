# 1. A build's stats sum all its sessions, by role.

# Given: a build whose session failed the gate once, went back to the same session, passed, was audited, took the
# audit's findings in its session, and landed.
# Each run of the build's session costs and reads as claude.json scripts it. Its first run reads a file that is not
# there, which fails.
exec kiln approve x
exec kiln run
stdout '^x: the gate failed; it goes back to the session, round 1 of 1$'
stdout '^x: landed on main'
grep 'Fix each finding' .claude-calls/build/1/3/prompt

# When: the developer runs kiln stats <name>.
exec kiln stats x

# Then: it shows the time, turns, cost, context, compactions, 7-day use, tool calls by tool, and failed calls, for
# each role and for the build as a whole.
# The build as a whole: 3 runs of its session, and 1 of the audit's.
stdout '^x, approved at [0-9a-f]{12}, started .* size: 1 acceptance test · landed$'
stdout '^time: +\S+( min)? · '
stdout '^runs: +4 runs · 5 turns · \$1\.75 · context 25k → 80k peak → 80k · 0 compactions · 7-day limit 20% → 23%$'
stdout '^tools: +3 Bash · 2 Read$'
stdout '^failed: +1 failed call$'

# The build role, in one session.
stdout '^  build role, session [0-9a-f-]{36}\n  time: +\S+( min)? · \S+ waiting on tools · '
stdout '^  runs: +3 runs · 4 turns · \$1\.00 · context 25k → 80k peak → 80k · 0 compactions · 7-day limit 20% → 23%$'
stdout '^  tools: +3 Bash · 1 Read$'
stdout '^  failed: +1 failed call$'

# The audit role, in one session.
stdout '^  audit role, session [0-9a-f-]{36}\n  time: +\S+( min)? · \S+ waiting on tools · '
stdout '^  runs: +1 run · 1 turn · \$0\.75 · context 30k → 30k peak → 30k · 0 compactions · 7-day limit 21% → 21%$'
stdout '^  tools: +1 Read$'
stdout '^  failed: +0 failed calls$'

-- go.mod --
module example.com/scratch

go 1.27
-- kiln.json --
{"gate": ["go vet ./...", "go test ./..."], "rounds": 1}
-- specs/x.md --
# Spec 1: x

## Acceptance tests

### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {
    "1": [
      {"limit": {"status": "allowed", "seven_day": 0.20}},
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/wrong/.\" ."},
        "usage": {"input_tokens": 10, "cache_read_input_tokens": 20000, "cache_creation_input_tokens": 5000}}},
      {"tool": {"name": "Read", "input": {"file_path": "missing.go"},
        "usage": {"input_tokens": 10, "cache_read_input_tokens": 35000, "cache_creation_input_tokens": 5000}}},
      {"result": {"result": "Built x.", "cost_usd": 0.50}}
    ],
    "2": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/right/.\" ."},
        "usage": {"input_tokens": 10, "cache_read_input_tokens": 55000, "cache_creation_input_tokens": 5000}}},
      {"result": {"result": "Fixed x.", "cost_usd": 0.25}}
    ],
    "3": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/audited/.\" ."},
        "usage": {"input_tokens": 10, "cache_read_input_tokens": 75000, "cache_creation_input_tokens": 5000}}},
      {"limit": {"status": "allowed", "seven_day": 0.23}},
      {"result": {"result": "Took the finding.", "cost_usd": 0.25}}
    ]
  }},
  "audit": {"1": {"1": [
    {"limit": {"status": "allowed", "seven_day": 0.21}},
    {"tool": {"name": "Read", "input": {"file_path": "x.go"},
      "usage": {"input_tokens": 10, "cache_read_input_tokens": 25000, "cache_creation_input_tokens": 5000}}},
    {"result": {"result": "X has no doc comment.\n\nread 2 packages, found 1", "cost_usd": 0.75}}
  ]}}
}
-- _given/wrong/x.go --
package scratch

func X() int { return 41 }
-- _given/right/x.go --
package scratch

func X() int { return 42 }
-- _given/audited/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/wrong/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
