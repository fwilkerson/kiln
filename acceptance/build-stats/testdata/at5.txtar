# 5. A landed build's summary is in its commit.

# Given: a build that landed.
# Its session costs $0.30 over 2 turns, one of them a read of a file that is not there. Its audit costs $0.12 over 1.
exec kiln queue x
exec kiln run
stdout '^x: landed on main'

# When: the developer reads the landing commit's message.
exec git log -1 --format=%B main

# Then: it holds the build's time, cost, turns and failed calls.
stdout '^feat\(x\): land the approved spec$'
stdout '^Build: (\d+s|[\d.]+ min) · \$0\.42 · 3 turns · 1 failed call$'

