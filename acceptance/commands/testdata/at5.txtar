// Package scratch is where kiln's builds land.
package scratch

// A answers 1.
func A() int { return 1 }
-- _given/a/acceptance/a/a_test.go --
package a_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.A(); got != 1 {
		t.Fatalf("A answers %d, want 1", got)
	}
}
