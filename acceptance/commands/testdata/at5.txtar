# 5. Completion offers only what a command takes.

# Given: one approved spec waiting for UAT, one queued, one on main that kiln holds no record of, and one starter
# with Status Proposed.
# a lands and waits for UAT, b is queued, c has no record, and d is the starter.
exec kiln queue a
exec kiln run
stdout '^a: landed on main'
exec kiln queue b
exec kiln status
stdout '^a: waiting for UAT$'
stdout '^b: queued$'
! stdout '^[cd]:'

# When: the completion asks kiln for the spec names after kiln accept, and after kiln queue.
exec kiln complete accept
cp stdout .tmp/accept
exec kiln complete queue
cp stdout .tmp/queue

# Then: kiln accept gets only the spec waiting for UAT.
cmp .tmp/accept _given/accept

# kiln queue gets the queued spec and the one with no record, and neither the spec waiting for UAT nor the starter.
cmp .tmp/queue _given/queue

-- _given/accept --
a
-- _given/queue --
b
c
-- go.mod --
module example.com/scratch

go 1.27
