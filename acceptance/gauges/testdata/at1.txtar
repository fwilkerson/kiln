# 1. A landing gets a reading.

# Given: kiln.json names a gauge whose command prints a number, and a spec is queued.
exec kiln queue x

# When: kiln run lands the spec.
exec kiln run
stdout '^x: landed on main'

# Then: kiln run's output shows the gauge's reading for that landing,
stdout '^x: gauge size: 3, line ≤ 5$'

# and kiln status shows it beside the gauge's line, and names the landing it read.
exec kiln status
stdout '^gauge size: 3, line ≤ 5, at x''s landing [0-9a-f]{12}$'
exec sh -c 'kiln status | grep -q "landing $(git rev-parse --short=12 main)$"'

-- .kiln/kiln.json --
{"acceptance": "acceptance/{spec}/", "gate": ["test -e ready"], "rounds": 1, "gauges": [{"name": "size", "command": "echo 3", "max": 5}]}
-- .kiln/specs/x.md --
