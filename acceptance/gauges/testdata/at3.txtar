# 3. A gauge measures the landing's own work.

# Given: kiln.json names a gauge whose command counts the files changed since the commit kiln gives it as the base.
# main already holds files the build leaves alone, such as old.txt, so a count of every file would be more than 2.
exec kiln queue x

# When: kiln run lands a spec whose build changed two files.
exec kiln run
stdout '^x: landed on main'
exec git diff --name-only main~1 main
stdout -count=2 '^.+$'

# Then: kiln status shows the reading 2.
exec kiln status
stdout '^gauge changed: 2, line ≤ 10, at x''s landing'

-- old.txt --
already on main
