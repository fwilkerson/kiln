# 4. A reading kiln could not take is unknown.

# Given: kiln.json names a gauge whose command fails.
exec kiln queue x

# When: kiln run lands a spec.
exec kiln run
stdout '^x: landed on main'

# Then: the spec waits for UAT, and kiln status shows the gauge's reading as unknown, not as zero.
exec kiln status
stdout '^x: waiting for UAT$'
stdout '^gauge size: unknown, line ≥ 0, at x''s landing'
! stdout 'gauge size: 0'

-- .kiln/kiln.json --
{"gate": ["test -e ready"], "rounds": 1, "gauges": [{"name": "size", "command": "echo 0; exit 3", "min": 0}]}
