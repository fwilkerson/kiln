-- claude.json --
{
  "build": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/a/.\" ."}}},
      {"result": {"result": "Built a.", "cost_usd": 0.30}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/wrong/.\" ."}}},
      {"result": {"result": "Built b.", "cost_usd": 0.10}}
    ]},
    "3": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/b/.\" ."}}},
      {"result": {"result": "Built b again.", "cost_usd": 0.20}}
    ]}
  },
  "audit": {
    "1": {"1": [{"result": {"result": "read 1 package, found 0", "cost_usd": 0.01}}]},
    "2": {"1": [{"result": {"result": "read 1 package, found 0", "cost_usd": 0.01}}]}
  }
}
-- _given/a/a.go --
// Package scratch is where kiln's builds land.
package scratch

// A answers 1.
func A() int { return 1 }
-- _given/wrong/b.go --
package scratch

// B answers 3.
func B() int { return 3 }
-- _given/wrong/acceptance/b/b_test.go --
package b_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.B(); got != 2 {
		t.Fatalf("B answers %d, want 2", got)
	}
}
-- _given/b/b.go --
package scratch

// B answers 2.
func B() int { return 2 }
