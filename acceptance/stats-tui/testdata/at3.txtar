# 3. Builds are grouped by spec.

# Given: two specs, one of them approved twice, so it has two builds.
# a lands. b's first build fails its gate with no round left, and stops. Approved again, b lands. Each run costs as
# claude.json scripts it, so each build's runs can be told apart.
exec kiln queue a
exec kiln queue b
exec kiln run
stdout '^a: landed on main'
stdout '^b: stopped'
exec kiln queue b
exec kiln run
stdout '^b: landed on main'

# When: the developer opens the spec approved twice,
term 120 30 kiln tui b

# Then: the spec shows both builds, each with how it ended,
screen 'builds of b · approved 2 times'
screen ' #1 +✗ stopped .*\$0\.10 '
screen ' #2 +✓ landed .*\$0\.21 '

# When: then each of its builds.
# Tab gives the builds panel the keys, with the newest build selected.
keys tab down enter

# Then: and each build shows only its own runs.
screen '^b · build 1 · .* · ✗ stopped'
screen '^1 +build +first run +\S+ +1 +\$0\.10 '
screen '^ +gate +✗ failed'
! screen '^2 +'
! screen '\$0\.20'
! screen '\$0\.30'
keys esc up enter
screen '^b · build 2 · .* · ✓ landed'
screen '^1 +build +first run +\S+ +1 +\$0\.20 '
screen '^2 +audit +audit, try 1 '
! screen '\$0\.10'
! screen '\$0\.30'

-- go.mod --
module example.com/scratch

go 1.27
-- .kiln/kiln.json --
{"gate": ["go vet ./...", "go test ./..."], "rounds": 0}
-- .kiln/specs/a.md --
