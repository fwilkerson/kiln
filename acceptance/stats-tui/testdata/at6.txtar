# 6. Finding a spec by name.

# Given: several specs.
exec kiln queue gate-flakes
exec kiln queue notifications
exec kiln queue status-line

# When: the developer types part of one spec's name into the filter.
term 100 20 kiln tui
screen 'gate-flakes'
screen 'notifications'
screen 'status-line'
keys / ate-fl

# Then: the side panel holds only the specs whose names hold that text.
screen '/ ate-fl'
screen 'gate-flakes'
! screen 'notifications'
! screen 'status-line'

-- .kiln/kiln.json --
{"gate": ["true"], "rounds": 1}
-- .kiln/specs/gate-flakes.md --
