  "build": {"1": {
    "1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/wrong/.\" ."}}},
      {"result": {"result": "Built x."}}
    ],
    "2": [
      {"tool": {"name": "Read", "input": {"file_path": "missing.go"}}},
      {"result": {"result": "Looked."}}
    ],
    "3": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/right/.\" ."}}},
      {"result": {"result": "Fixed x."}}
    ]
