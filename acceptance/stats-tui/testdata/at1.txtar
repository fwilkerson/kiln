### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.

## Technical Plan

## Alternatives Considered
-- claude.json --
{
  "build": {"1": {
    "1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/wrong/.\" ."}}},
      {"result": {"result": "Built x.", "cost_usd": 0.50}}
    ],
    "2": [
      {"tool": {"name": "Write", "input": {"file_path": ".kiln/specs/x.md", "content": "changed"}}},
      {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/waiting\" && while [ ! -e \"$WORK/go-on\" ]; do sleep 0.1; done"}}},
      {"tool": {"name": "Bash", "input": {"command": "echo the next call && cp -R \"$WORK/_given/right/.\" . && while [ ! -e \"$WORK/done\" ]; do sleep 0.1; done"}}},
      {"result": {"result": "Fixed x.", "cost_usd": 0.25}}
    ]
  }},
  "audit": {"1": {"1": [{"result": {"result": "read 1 package, found 0"}}]}}
}
-- _given/wrong/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 41.
func X() int { return 41 }
-- _given/wrong/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
-- _given/right/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
