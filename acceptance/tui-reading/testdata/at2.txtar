# 2. A spec's builds, newest first.

# Given: a spec approved twice, so it has two builds.
# Each build lands, and each costs as claude.json scripts it, so the two can be told apart.
exec kiln queue x
exec kiln run
stdout '^x: landed on main'
exec sh -c 'echo "Revision 2." >>.kiln/specs/x.md && git commit --quiet -am "docs(x): revise"'
exec kiln queue x
exec kiln run
stdout '^x: landed on main'

# When: the developer opens the spec.
# Selecting it on home opens its builds in the builds panel.
term 120 30 kiln tui
screen '◆ x'
keys j
screen 'builds of x · approved 2 times'

# Then: the second build is listed above the first,
screen ' #2 +✓ landed .*\$0\.21 .*\n.* #1 +✓ landed .*\$0\.11 '

# and is the one Enter opens.
# Amended 2026-11-12, from "and is the one selected": the spec's own screen is gone, and home's keys stay on the spec.
keys enter
screen '^x · build 2 · '
screen '^1 +build +first run +\S+ +1 +\$0\.20 '

-- go.mod --
module example.com/scratch

go 1.27
-- .kiln/kiln.json --
{"gate": ["go vet ./...", "go test ./..."], "rounds": 0}
-- .kiln/specs/x.md --
# Spec 1: x

Status: Approved, 2026-11-09

## Overview

## Goals

## Non-goals

## Open Questions

## Acceptance tests

### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.

## Technical Plan

## Alternatives Considered
-- claude.json --
{
  "build": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/right/.\" ."}}},
      {"result": {"result": "Built x.", "cost_usd": 0.10}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo '// X is revised.' >>x.go"}}},
      {"result": {"result": "Built x again.", "cost_usd": 0.20}}
    ]}
  },
  "audit": {
    "1": {"1": [{"result": {"result": "read 1 package, found 0", "cost_usd": 0.01}}]},
    "2": {"1": [{"result": {"result": "read 1 package, found 0", "cost_usd": 0.01}}]}
  }
}
-- _given/right/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/right/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
