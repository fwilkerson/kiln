{
  "build": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/right/.\" ."}}},
      {"result": {"result": "Built x."}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo '// Revision 2.' >>x.go"}}},
      {"result": {"result": "Built x again."}}
    ]},
    "3": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo '// Revision 3.' >>x.go"}}},
      {"result": {"result": "Built x 3 times."}}
    ]},
    "4": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo '// Revision 4.' >>x.go"}}},
      {"result": {"result": "Built x 4 times.\n\nIt still answers 42."}}
    ]}
  },
  "audit": {
    "1": {"1": [{"result": {"result": "read 1 package, found 0"}}]},
    "2": {"1": [{"result": {"result": "read 1 package, found 0"}}]},
    "3": {"1": [{"result": {"result": "read 1 package, found 0"}}]},
    "4": {"1": [{"result": {"result": "read 1 package, found 0"}}]}
  }
