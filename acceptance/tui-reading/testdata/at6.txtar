# 6. One mark for what kiln does not know.

# Given: a build whose session is running, so kiln does not yet know its cost, its turns or its time.
# Its run copies in the work, touches waiting, and waits for done. Until its result event, its cost and turns are
# unknown, and so are the build's cost, turns and time.
exec kiln queue x
exec kiln run &
exec sh -c 'i=0; while [ ! -e waiting ] && [ $i -lt 900 ]; do sleep 0.1; i=$((i+1)); done; [ -e waiting ]'

# When: the developer opens kiln tui,
term 120 30 kiln tui
screen '▶ x · build role · first run · running'

# Then: each number kiln does not know shows as ?, and no screen shows the word "unknown".
screen '\w{3} \d\d \d\d:\d\d x +▶ running +1 test +\d+[sm] +\? +\? +\? +0 +│$'
! screen 'unknown'

# When: the spec's builds,
# Amended 2026-11-12, from "the spec's screen": that screen is gone, and selecting a spec on home lists its builds.
keys j
screen 'builds of x · approved once'

# Then:
screen ' #1 +▶ running +1 test +\d+[sm] +\? +\? +\? +0 +│$'
! screen 'unknown'

# When: the build,
keys enter
screen '^x · build 1 · '

# Then:
screen '^time \?: .* · cost \? · \? turns · \? failed, \? refused$'
screen '^1 +build +first run +▶ \S+ +\? +\? +\? '
! screen 'unknown'

# When: and the running run.
keys enter
screen '^x · build 1 · run 1: first run · build role · '

# Then:
screen '^▶ running .* · turns \? · cost \?$'
! screen 'unknown'

exec touch done
wait
stdout '^x: landed on main'

