    "1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/right/.\" . && touch \"$WORK/waiting\" && while [ ! -e \"$WORK/done\" ]; do sleep 0.1; done"}}},
      {"result": {"result": "Built x.", "cost_usd": 0.50}}
    ]
