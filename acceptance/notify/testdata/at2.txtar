# 2. A spec waiting for UAT notifies, and sums up its build.

# Given: an approved spec whose build passes its gate with no amendment.
# Its first audit ends with no result, and runs again. Its finding goes back to the session, which fixes it.
exec kiln queue x

# When: the developer runs kiln run.
exec kiln run
cp stdout .tmp/run

# Then: its output holds one notification, which names the spec and the state kiln status shows for it, waiting for
# UAT.
stdout -count=1 '\x1b\]9;'
stdout '^\x1b\]9;kiln: x waiting for UAT\x07'
exec kiln status
stdout '^x: waiting for UAT$'

# After the line that says the build landed, the output shows the build's time, cost, turns and failed calls, its
# rounds, the files it changed, and the command that accepts the spec.
exec cat .tmp/run
stdout '(?s)^x: landed on main at [0-9a-f]{12}, and waits for UAT$\n\x1b\]9;[^\x07]*\x07  [^·\n]+ · \$\d+\.\d\d · 2 turns · 0 failed calls$'
stdout '(?s)^x: landed on main at .*^  0 of 1 round · the audit sent findings back$'
stdout '(?s)^x: landed on main at .*^  2 files changed, 18 insertions, 0 deletions$'
stdout '(?s)^x: landed on main at .*^  next: .*kiln accept x\b'
exec git diff --shortstat main^ main
stdout '^ 2 files changed, 18 insertions\(\+\)$'

-- go.mod --
module example.com/scratch

go 1.27
