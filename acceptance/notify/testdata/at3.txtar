# 3. A spec waiting on its branch notifies, and shows its amendments.

# Given: an approved spec whose build amends it, and passes its gate.
exec kiln queue x

# When: the developer runs kiln run.
exec kiln run
cp stdout .tmp/run

# Then: its output holds one notification, which names the spec and the state kiln status shows for it, waiting on
# its branch with amendments.
stdout -count=1 '\x1b\]9;'
stdout '^\x1b\]9;kiln: x waiting on its branch with amendments\x07'
exec kiln status
stdout '^x: waiting on its branch with amendments, kiln/x$'

# After the line that says the build waits, the output shows the build's time, cost, turns and failed calls, the
# amendments, and the commands that accept and reject them.
exec cat .tmp/run
stdout '(?s)^x: waits on kiln/x, with amendments for UAT$\n\x1b\]9;[^\x07]*\x07  [^·\n]+ · \$\d+\.\d\d · 1 turn · 0 failed calls$'
stdout '(?s)^x: waits on kiln/x, .*^  # Amendments to .kiln/specs/x\.md$\n.*^  - \*\*Then\*\*: it answers 43\.$\n.*^  42 is taken\.$'
stdout '(?s)^x: waits on kiln/x, .*^  next: .*kiln accept x\b.*kiln reject x\b'

