# 1. An approved spec lands.

# Given: an approved spec whose build makes its acceptance tests pass.
exec kiln queue x

# When: the developer runs kiln run.
exec kiln run
stdout '^x: landed on main'

# Then: main holds the build's work,
exec git log -1 --format=%s main
stdout '^feat\(x\): land the approved spec$'
exec git diff --quiet main
exists x.go
cmp acceptance/x/x_test.go _given/x/acceptance/x/x_test.go

# its acceptance tests pass there,
exec go test ./acceptance/x/
stdout '^ok'

# and kiln status shows it waiting for UAT.
exec kiln status
stdout '^x: waiting for UAT$'
! stdout 'stopped|amendments'

# The first audit ended with no result, so it ran again. Its finding went back to the session, which fixed it
# before the work landed.
exists .claude-calls/audit/2/1/call.json
grep 'x.go:3  false comment' .claude-calls/build/1/2/prompt
exec git show main:x.go
stdout '^// X answers 42.$'

-- go.mod --
module example.com/scratch

go 1.27
-- .kiln/kiln.json --
{"acceptance": "acceptance/{spec}/", "gate": ["go vet ./...", "go test ./..."], "rounds": 1}
-- .kiln/specs/x.md --
# Spec 1: x

Status: Approved, 2026-11-09

## Overview

## Goals

## Non-goals

## Open Questions

## Acceptance tests

### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.

## Technical Plan

## Alternatives Considered
-- claude.json --
{
  "build": {"1": {
    "1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
      {"result": {"result": "Built x."}}
    ],
    "2": [
      {"tool": {"name": "Edit", "input": {"file_path": "x.go", "old_string": "answers 41", "new_string": "answers 42"}}},
      {"result": {"result": "The finding is fixed."}}
    ]
  }},
  "audit": {
    "1": {"1": [{"result": {"is_error": true, "api_error_status": 529, "result": "API Error: 529 Overloaded"}}]},
    "2": {"1": [
      {"result": {"result": "1. x.go:3  false comment\nreaches    the doc says 41\n\nread 2 packages, found 1"}}
    ]}
  }
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 41.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
