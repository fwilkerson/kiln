# 6. Accepting a spec retires it.

# Given: a spec waiting for UAT, landed or on its branch with an amendment.
# x lands, and y waits on its branch with an amendment.
exec kiln queue x
exec kiln queue y
exec kiln run
exec kiln status
stdout '^x: waiting for UAT$'
stdout '^y: waiting on its branch with amendments'

# When: the developer runs kiln accept.
exec kiln accept x
stdout '^x: accepted'
exec kiln accept y
stdout '^y: accepted'

# Then: main holds the spec's work and its amendments,
exec git diff --quiet main
exists x.go y.go
exec go test ./...
exec sh -c '$(sed -n "s/^- Spec 2: y: .\(git show .*\).$/\1/p" PRODUCT.md)'
stdout '^- \*\*Then\*\*: it answers 8.$'
! stdout 'answers 7'
exec sh -c 'git merge-base --is-ancestor "$(sed -n "s/.*git show \([0-9a-f]*\):.kiln\/specs\/y.md.*/\1/p" PRODUCT.md)" main'

# specs/ no longer holds it,
! exists .kiln/specs/x.md .kiln/specs/y.md .kiln/specs/y.amend.md

# and PRODUCT.md names it with its commit.
grep '^- Spec 1: x: `git show [0-9a-f]{12}:.kiln/specs/x.md`$' PRODUCT.md
grep '^- Spec 2: y: `git show [0-9a-f]{12}:.kiln/specs/y.md`$' PRODUCT.md
exec sh -c '$(sed -n "s/^- Spec 1: x: .\(git show .*\).$/\1/p" PRODUCT.md)'
stdout '^- \*\*Then\*\*: it answers 42.$'
exec sh -c 'git merge-base --is-ancestor "$(sed -n "s/.*git show \([0-9a-f]*\):.kiln\/specs\/x.md.*/\1/p" PRODUCT.md)" main'
exec kiln status
stdout '^kiln holds no approved spec$'

-- go.mod --
module example.com/scratch

go 1.27
