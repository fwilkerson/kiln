# 5. The audit reads the stack once its gate passes

# Given: the project chooses the split workflow, and the stack passes its gate.
# The build session changes the harness beside its code. The verify session writes its tests.
exec kiln queue x

# When: the audit runs.
exec kiln run
stdout '^x: the audit reads \. acceptance/x harness$'
stdout '^x: landed on main'

# Then: the audit reads the directories of both sessions' files,
grep 'Audit these directories: `\.`, `acceptance/x`, `harness`\.' .claude-calls/audit/1/1/prompt

# its prompt names each harness file the build session changed,
grep 'harness/h\.go' .claude-calls/audit/1/1/prompt
grep 'The build session changed these files of the test harness[^\n]*harness/h\.go' .claude-calls/audit/1/1/prompt

# and its findings go to both sessions.
grep 'h\.go:3 weak test' .claude-calls/build/1/2/prompt
grep 'h\.go:3 weak test' .claude-calls/verify/1/2/prompt

-- .kiln/kiln.json --
{"workflow": "split", "acceptance": "acceptance/{spec}/", "gate": ["go vet ./...", "go test ./..."], "rounds": 3, "harness": ["harness/"]}
