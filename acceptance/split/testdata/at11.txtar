# 11. The build session learns of an amendment

# Given: the project chooses the split workflow, and the verify session amends a Given, When, Then.
exec kiln queue x

# When: the build session next runs.
# The audit sends a finding back, so it runs again.
exec kiln run
stdout '^x: waits on kiln/x, with amendments for UAT'
exists .claude-calls/build/1/2/prompt

# Then: its prompt holds the amendment's new wording.
grep '\*\*Then\*\*: it answers 42, or more\.' .claude-calls/build/1/2/prompt
! grep 'it answers 42, or more' .claude-calls/build/1/1/prompt

