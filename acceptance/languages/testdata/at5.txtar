# 5. A failure that names no test points at KILN_JUNIT.

# Given: a project whose gate command exits 1 and writes no XML, both on the build's commit and on main.
# kiln.json allows one round, so the gate's report goes back to the build in its next prompt.

# When: a build reaches the gate.
exec kiln queue t
exec kiln run

# Then: the gate fails, and its report says the command named no failed test and names KILN_JUNIT.
stdout '^t: stopped'
exists .claude-calls/build/1/2/prompt
grep '^The gate failed' .claude-calls/build/1/2/prompt
grep 'named no failed test' .claude-calls/build/1/2/prompt
grep '\$KILN_JUNIT' .claude-calls/build/1/2/prompt

-- .kiln/kiln.json --
{"gate": ["exit 1"], "rounds": 1}
-- .kiln/specs/t.md --
