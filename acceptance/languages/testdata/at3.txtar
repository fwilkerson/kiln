# 3. A test that fails in setup on main too does not block a build.

# Given: a project whose gate command reports a setup error on test_a, both on the build's commit and on main.

# When: a build reaches the gate.
exec kiln queue t
exec kiln run

# Then: the gate passes.
# A build whose gate passes goes on to its audit, and lands.
stdout '^t: the audit reads \.$'
stdout '^t: landed on main'
! stdout 'failing:'

-- .kiln/kiln.json --
{"gate": ["if [ \"$(git rev-parse HEAD)\" = \"$(git rev-parse main)\" ]; then cp _junit/main.xml \"$KILN_JUNIT\"; else cp _junit/build.xml \"$KILN_JUNIT\"; fi; exit 1"], "rounds": 1}
