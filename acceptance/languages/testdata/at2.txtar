# 2. A pytest test that fails only on the build's commit fails the gate.

# Given: a project whose kiln.json allows no round after a failing gate, and whose gate command reports test_a and
# test_b failed on the build's commit, and only test_a on main.

# When: a build reaches the gate.
exec kiln queue t
exec kiln run

# Then: the build stops, and kiln names test_b as failing and not test_a.
stdout '^t: stopped'
stdout '^  failing: tests\.test_x::test_b$'
! stdout 'failing: .*test_a'
exec kiln status
stdout '^t: stopped$'

-- .kiln/kiln.json --
{"acceptance": "acceptance/{spec}/", "gate": ["if [ \"$(git rev-parse HEAD)\" = \"$(git rev-parse main)\" ]; then cp _junit/main.xml \"$KILN_JUNIT\"; else cp _junit/build.xml \"$KILN_JUNIT\"; fi; exit 1"], "rounds": 0}
-- .kiln/specs/t.md --
