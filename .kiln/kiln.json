{
  "gate": [
    "go vet ./...",
    "go test ./..."
  ],
  "rounds": 3,
  "workflow": "split",
  "acceptance": "acceptance/{spec}/",
  "harness": [
    "internal/scenariotest/",
    "internal/termtest/"
  ],
  "reaudit": [
    "internal/scenariotest/",
    "internal/termtest/"
  ],
  "hosts": [
    "proxy.golang.org",
    "sum.golang.org",
    "storage.googleapis.com",
    "pypi.org",
    "files.pythonhosted.org"
  ],
  "writable": [
    "go env GOCACHE GOMODCACHE",
    "uv cache dir"
  ],
  "gauges": [
    {
      "name": "code health",
      "command": ".kiln/gauges/code-health",
      "min": 10
    }
  ]
}
