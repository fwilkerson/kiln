{
  "$schema": "./kiln.schema.json",
  "gate": [
    "go vet ./...",
    "go test -timeout 30m ./..."
  ],
  "rounds": 3,
  "testSession": true,
  "acceptance": "uat/{spec}/",
  "shared": [
    "internal/hometest/",
    "internal/scenariotest/",
    "internal/termtest/"
  ],
  "reaudit": [
    "internal/hometest/",
    "internal/scenariotest/",
    "internal/termtest/"
  ],
  "hosts": [
    "proxy.golang.org",
    "sum.golang.org",
    "storage.googleapis.com",
    "pypi.org",
    "files.pythonhosted.org"
  ],
  "writable": [
    "go env GOCACHE GOMODCACHE",
    "echo \"$(go env GOPATH | cut -d: -f1)/pkg/sumdb\"",
    "uv cache dir"
  ],
  "notify": ".kiln/notify"
}
