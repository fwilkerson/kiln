{
  "$schema": "./generated/kiln.schema.json",
  "gate": [
    "go vet ./...",
    "go test -timeout 30m ./..."
  ],
  "rounds": 3,
  "verifySession": true,
  "acceptanceTests": "uat/{spec}/",
  "testHelpers": [
    "internal/hometest/",
    "internal/scenariotest/",
    "internal/termtest/"
  ],
  "testFiles": [
    "*_test.go",
    "testdata"
  ],
  "reaudit": [
    "internal/hometest/",
    "internal/scenariotest/",
    "internal/termtest/"
  ],
  "allowedHosts": [
    "proxy.golang.org",
    "sum.golang.org",
    "storage.googleapis.com",
    "pypi.org",
    "files.pythonhosted.org"
  ],
  "allowUnixSockets": true,
  "writablePathCommands": [
    "go env GOCACHE GOMODCACHE",
    "echo \"$(go env GOPATH | cut -d: -f1)/pkg/sumdb\"",
    "uv cache dir"
  ],
  "notify": ".kiln/notify"
}
