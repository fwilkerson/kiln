{
  "gate": [
    "go vet ./...",
    "go test ./..."
  ],
  "rounds": 3,
  "workflow": "split",
  "acceptance": "uat/{spec}/",
  "harness": [
    "internal/scenariotest/",
    "internal/termtest/"
  ],
  "reaudit": [
    "internal/scenariotest/",
    "internal/termtest/"
  ],
  "hosts": [
    "proxy.golang.org",
    "sum.golang.org",
    "storage.googleapis.com",
    "pypi.org",
    "files.pythonhosted.org"
  ],
  "writable": [
    "go env GOCACHE GOMODCACHE",
    "echo \"$(go env GOPATH | cut -d: -f1)/pkg/sumdb\"",
    "uv cache dir"
  ],
  "mcp": {
    "codescene": {"command": "cs-mcp-auth"}
  },
  "gauges": [
    {
      "name": "code health",
      "command": ".kiln/gauges/code-health",
      "min": 10
    }
  ],
  "monitors": [
    {
      "name": "uat",
      "every": "24h",
      "check": ".kiln/monitors/uat",
      "agent": ".kiln/agents/fold.md",
      "prompt": "Fold what the check found into uat/testdata/, as your instructions say.",
      "accept": true,
      "tests": true
    },
    {
      "name": "code-health",
      "every": "24h",
      "check": ".kiln/monitors/code-health 3",
      "agent": ".kiln/agents/refactor.md",
      "prompt": "Refactor each file the check listed to Code Health 10.0, as your instructions say."
    }
  ]
}
