#!/bin/sh
# The command of the deps monitor, for a Go project. It requires each update the check finds, as lib/updates says,
# then tidies go.mod and go.sum. It vendors the modules again where the project vendors them.
#
# kiln's own copy writes docs/guide.md again, from the practices module go.mod now requires. TestGuide fails while the
# two differ.
set -eu

updates=$(sh "$(dirname "$0")/lib/updates")
[ -n "$updates" ] || exit 0

# shellcheck disable=SC2046 # each update is one argument.
go get $(printf '%s\n' "$updates" | awk '{ print $1 "@" $3 }')
go mod tidy
[ ! -d vendor ] || go mod vendor
go tool guide >docs/guide.md
