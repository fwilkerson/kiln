#!/bin/sh
# The check of kiln's gate-time monitor. It asks for a fix when the gate has slowed. Then it prints the trend, and the
# slowest packages and tests at main's tip, for the monitor's agent. Its last line is the JSON object kiln reads.
#
#   .kiln/monitors/gate-time [rise] [window]     rise in percent, 50 by default; window in gates, 20 by default
#
# It asks for a fix when the last window's gates took more than rise longer than those of the window before. A
# window's time is the upper quartile of its gates' times. It never asks while the last window holds a gate from before
# the monitor last started a fix, so each fix is judged by the gates that follow it.
#
# It reads each passing gate of a build's work from kiln ledger, and no landing's. A landing's gate mostly reads
# Go's test cache, and ends within two seconds. A gate that runs main's checks too takes about twice as long as one
# that runs the work alone. The builds' rounds mix the two kinds, so a window's median jumps between them. Its upper
# quartile holds to the slower kind, and moves only once a quarter of the window moves.
#
# A fix changes the ledger only once it lands, so the monitor's entry in kiln.json keeps this check out of the gate.
# monitor below is the entry's name.
set -eu
export LC_ALL=C

monitor=gate-time
rise=${1:-50}
window=${2:-20}

# gates holds a line for each gate the series counts, oldest first: when it started, and its seconds. A failed kiln
# ledger fails the check, rather than reading as no gate.
gates=$(kiln ledger --kind gate)
gates=$(printf '%s\n' "$gates" | jq -r 'select(.passed and (.landing | not)) | "\(.at | fromdate)\t\(.seconds)"')
count=$(printf '%s\n' "$gates" | grep -c . || true)
if [ "$count" -lt $((2 * window)) ]; then
  echo "{\"fix\": false, \"summary\": \"the ledger holds $count gates to compare, of the $((2 * window)) needed\"}"
  exit 0
fi

# fixed is when the monitor last started a fix, or 0.
fixed=$(kiln ledger --kind monitor --name "$monitor")
fixed=$(printf '%s\n' "$fixed" | jq -r 'select(.found == "fix") | .at | fromdate' | tail -n 1)
recent=$(printf '%s\n' "$gates" | tail -n "$window")
before=$(printf '%s\n' "$gates" | tail -n $((2 * window)) | head -n "$window")

# quartile prints the upper quartile of the seconds read, by nearest rank, in whole seconds.
quartile() { cut -f2 | sort -n | awk -v n="$window" 'NR == int((3 * n + 3) / 4) { printf "%.0f\n", $1 }'; }
now=$(printf '%s\n' "$recent" | quartile)
was=$(printf '%s\n' "$before" | quartile)
change=$(awk -v a="$was" -v b="$now" 'BEGIN { printf "%+.0f", (b - a) * 100 / a }')
trend="${was}s to ${now}s, $change%, in the upper quartile of the last $window gates' times against the $window before"

if awk -v f="${fixed:-0}" -v s="$(printf '%s\n' "$recent" | head -n 1 | cut -f1)" 'BEGIN { exit !(f >= s) }'; then
  echo "{\"fix\": false, \"summary\": \"$trend; the monitor's last fix started within the last $window gates\"}"
  exit 0
fi

if awk -v a="$was" -v b="$now" -v r="$rise" 'BEGIN { exit !(b <= a * (1 + r / 100)) }'; then
  echo "{\"fix\": false, \"summary\": \"$trend, within $rise%\"}"
  exit 0
fi

echo "The gate slowed: $trend, past the $rise% this check allows."
echo "The last $window gates' times, oldest first, in seconds:" \
  "$(printf '%s\n' "$recent" | awk '{ printf "%s%.0f", (NR > 1 ? " " : ""), $2 }')"
echo

# A bare mktemp ignores TMPDIR on macOS, and a session's sandbox lets it write nowhere else.
run=$(mktemp "${TMPDIR:-/tmp}/gate-time.XXXXXX")
trap 'rm -f "$run"' EXIT
start=$(date +%s)
go test -count=1 -json ./... >"$run" 2>/dev/null || true
took=$(($(date +%s) - start))

# A test's time includes its subtests', so only a test with none is listed. A package's time is its test binary's.
echo "go test -count=1 ./... at main's tip, $(git rev-parse --short=12 HEAD), took ${took}s. Its slowest packages:"
jq -r 'select(.Test == null and (.Action == "pass" or .Action == "fail") and .Elapsed != null)
  | "\(.Elapsed)\t\(.Package)"' "$run" | sort -rn | head -n 5 | awk -F'\t' '{ printf "  %6.1fs  %s\n", $1, $2 }'
echo "Its slowest tests:"
jq -rn '[inputs | select(.Test != null and (.Action == "pass" or .Action == "fail"))] as $ran
  | ($ran | map(.Package + " " + .Test)) as $names
  | $ran[] | select((.Package + " " + .Test + "/") as $p | any($names[]; startswith($p)) | not)
  | "\(.Elapsed)\t\(.Test) (\(.Package))"' "$run" | sort -rn | head -n 10 |
  awk -F'\t' '{ printf "  %6.1fs  %s\n", $1, $2 }'
echo
echo "{\"fix\": true, \"summary\": \"the gate slowed $change%: ${was}s to ${now}s\"}"
