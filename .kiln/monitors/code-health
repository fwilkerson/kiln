#!/bin/sh
# The check of kiln's code-health monitor. It asks for a fix while a Go file scores below 10 by go tool health, the
# practices module's command, which counts six rules of the guide's "Inside a function".
#
#   .kiln/monitors/code-health 3
#
# At main, it prints the files with the lowest scores, as many as its argument names, each with what health found in
# it, for the monitor's agent to refactor. In a fix's gate, where the commit differs from main, it judges the fix
# instead: each file the fix changed scores 10. Its last line is the JSON object kiln reads.
set -eu

n=${1:?name how many files one fix refactors, such as 3}
export LC_ALL=C

found=$(mktemp)
failed=$(mktemp)
trap 'rm -f "$found" "$failed"' EXIT

# health exits 1 when a file scores below 10, and when it could not run. Only a run that printed a score ran.
if ! go tool health . >"$found" 2>"$failed" && ! grep -Eq '^ *[0-9]+  ' "$found"; then
  echo "code-health: go tool health could not run:" >&2
  cat "$failed" >&2
  exit 1
fi

# scores prints "<score> <file>" for each file health scored below 10, the lowest first.
scores() {
  awk '/^ *[0-9]+  / { print $1, $2 }' "$found" | sort -k1,1n -k2,2
}

# findings prints what health found in the file it is given, without the line numbers. A line number moves with any
# commit, and kiln holds a monitor only while its check prints the same.
findings() {
  awk -v at="$1:" 'index($0, at) == 1 { sub(/^[^ ]+ /, ""); print "  " $0 }' "$found"
}

changed=$(git diff --name-only --diff-filter=d main...HEAD)
if [ -n "$changed" ]; then
  low=$(scores | while read -r score f; do
    if echo "$changed" | grep -qxF "$f"; then echo "$score $f"; fi
  done)
  if ! echo "$changed" | grep -q '\.go$'; then
    echo '{"fix": true, "summary": "the fix changed no Go file"}'
  elif [ -z "$low" ]; then
    echo '{"fix": false, "summary": "each file the fix changed scores 10"}'
  else
    echo "$low" | while read -r score f; do
      echo "$f scores $score: each file a fix changes reaches 10."
      findings "$f"
    done
    echo "{\"fix\": true, \"summary\": \"files the fix changed that score below 10: $(echo "$low" | wc -l | tr -d ' ')\"}"
  fi
  exit 0
fi

# A fix writes nothing under uat/, so a file there is none it could refactor.
low=$(scores | grep -v ' uat/' || true)
if [ -z "$low" ]; then
  echo '{"fix": false, "summary": "each Go file scores 10"}'
  exit 0
fi

lowest=$(echo "$low" | head -n "$n")
echo "$lowest" | while read -r score f; do
  echo "$f scores $score"
  findings "$f"
done
named=$(echo "$lowest" | awk '{ printf "%s%s %s", sep, $2, $1; sep = ", " }')
echo "{\"fix\": true, \"summary\": \"$(echo "$low" | wc -l | tr -d ' ') files score below 10; the lowest: $named\"}"
