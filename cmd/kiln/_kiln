#compdef kiln

# The zsh completion of kiln. kiln answers both lists, so the rules of what each command takes live once, in Go:
# kiln complete lists kiln's commands, and kiln complete <command> the spec names that command takes.
# kiln complete monitor lists its commands, kiln complete monitor run the monitors, and kiln complete monitor add the
# monitors kiln ships that fit the project's preset. kiln monitor add takes a directory too. kiln complete help lists
# the topics of kiln help.
local -a found expl
case $CURRENT in
  2)
    found=(${(f)"$(_call_program commands kiln complete 2>/dev/null)"})
    _wanted commands expl 'kiln command' compadd -a found
    ;;
  3)
    found=(${(f)"$(_call_program specs kiln complete ${(q)words[2]} 2>/dev/null)"})
    _wanted specs expl 'spec' compadd -a found
    ;;
  4)
    found=(${(f)"$(_call_program monitors kiln complete ${(q)words[2]} ${(q)words[3]} 2>/dev/null)"})
    _wanted monitors expl 'monitor' compadd -a found
    [[ ${words[3]} == add ]] && _path_files -/
    ;;
esac
