{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(chmod *)",
      "Bash(touch *)",
      "Bash(pwd)",
      "Read(~/github.com/fwilkerson/eidos/**)",
      "Read(~/github.com/fwilkerson/odh/**)",
      "Bash(awk *)",
      "Bash(tr *)",
      "Bash(printf *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(jq *)",
      "Bash(xargs *)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git -C * commit*)",
      "Bash(git -C * reset*)",
      "Bash(git -C * checkout*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build",
        "~/go/pkg/mod"
      ]
    },
    "network": {
      "allowLocalBinding": true
    }
  },
  "env": {
    "GOFLAGS": "-buildvcs=false"
  }
}
