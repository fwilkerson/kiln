# 2. A crossed gauge starts a fix, and the agent reads what the gauge printed.

env KILN_OPEN=true

# Given: a monitor that names a gauge, and a main that holds two files the gauge counts against its line. Main's
# last commit changed neither file.
cp $WORK/_given/other.md other.md
exec git add other.md
exec git commit -q -m 'add other.md'

# When: kiln monitor run runs.
exec kiln monitor run

# Then: a fix starts.
exists .claude-calls/fixer/1/1/prompt

# The agent's first message holds what the gauge printed of each of the two files, and the reading beside the
# gauge's line.
grep 'low: a\.txt' .claude-calls/fixer/1/1/prompt
grep 'low: b\.txt' .claude-calls/fixer/1/1/prompt
grep 'count: 2, line ≤ 0, crossed' .claude-calls/fixer/1/1/prompt

# kiln status shows that reading as crossed.
exec kiln status
stdout '^\s*count: 2, line ≤ 0, crossed$'

-- .kiln/kiln.json --
{"gate": ["true"], "rounds": 2, "gauges": [
 {"name": "count", "command": "sh .kiln/gauges/count", "max": 0}
], "monitors": [
 {"name": "lows", "every": "24h", "gauge": "count", "agent": ".kiln/agents/fixer.md", "prompt": "Make each file the gauge names say fine."}
]}
-- .kiln/gauges/count --
n=0
read=
for f in $(git diff --name-only --diff-filter=d "$KILN_BASE" HEAD -- '*.txt'); do
  read=yes
  if grep -q low "$f"; then
    echo "low: $f"
    n=$((n + 1))
  fi
done
if [ -n "$read" ]; then
  echo "$n"
fi
-- .kiln/agents/fixer.md --
Fix the files the gauge names.
-- ok.txt --
fine
-- a.txt --
low a
-- b.txt --
low b
-- _given/other.md --
other work
-- claude.json --
{
  "fixer": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "echo fine >a.txt && echo fine >b.txt"}}},
    {"result": {"result": "Both files say fine."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}}
}
