# 3. The gauge holds the fix to its line, over what the fix changed.

env KILN_OPEN=true

# Given: test 2's repository. The agent's first turn changes one of the two files, and leaves it counting against
# the line. Its second turn changes that file so that it no longer counts. No turn changes the other file.
cp $WORK/_given/other.md other.md
exec git add other.md
exec git commit -q -m 'add other.md'

# When: kiln monitor run runs.
exec kiln monitor run

# Then: the gate fails after the first turn, and the agent's next message holds what the gauge printed of the file
# it changed, and nothing of the other file.
exists .claude-calls/fixer/1/2/prompt
grep 'low: a\.txt' .claude-calls/fixer/1/2/prompt
! grep 'b\.txt' .claude-calls/fixer/1/2/prompt

# The fix lands after the second turn, though the other file still counts against the line.
exec git show main:a.txt
stdout '^fine a$'
exec git show main:b.txt
stdout '^low b$'
exec kiln status
stdout '^lows: landed'

# kiln status shows the gauge's reading of that landing, which did not cross.
stdout '^gauge count: 0, line ≤ 0, at '
! stdout '^gauge count: .*crossed'

-- .kiln/kiln.json --
{"gate": ["true"], "rounds": 2, "gauges": [
 {"name": "count", "command": "sh .kiln/gauges/count", "max": 0}
], "monitors": [
 {"name": "lows", "every": "24h", "gauge": "count", "agent": ".kiln/agents/fixer.md", "prompt": "Make each file the gauge names say fine."}
]}
-- .kiln/gauges/count --
n=0
read=
for f in $(git diff --name-only --diff-filter=d "$KILN_BASE" HEAD -- '*.txt'); do
  read=yes
  if grep -q low "$f"; then
    echo "low: $f"
    n=$((n + 1))
  fi
done
if [ -n "$read" ]; then
  echo "$n"
fi
-- .kiln/agents/fixer.md --
Fix the files the gauge names.
-- ok.txt --
fine
-- a.txt --
low a
-- b.txt --
low b
-- _given/other.md --
other work
-- claude.json --
{
  "fixer": {"1": {
    "1": [
      {"tool": {"name": "Bash", "input": {"command": "echo 'low a, edited' >a.txt"}}},
      {"result": {"result": "Edited a.txt."}}
    ],
    "2": [
      {"tool": {"name": "Bash", "input": {"command": "echo 'fine a' >a.txt"}}},
      {"result": {"result": "a.txt says fine."}}
    ]
  }},
  "audit": {"1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}}
}
