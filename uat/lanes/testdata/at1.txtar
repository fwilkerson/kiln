# 1. A spec builds and lands while a monitor's fix is at work.

env KILN_OPEN=true

# Given: kiln monitor run at work on a fix, whose agent's session has not ended its turn. The session touches
# .tmp/fixing, then waits for .tmp/fix-go.
exec kiln monitor run &mon&
exec await .tmp/fixing

# A spec is queued.
exec kiln queue x

# When: the developer runs kiln fire.
exec kiln fire

# Then: the spec's build lands on main,
stdout '^x: landed on main at [0-9a-f]+, and waits for UAT'
exec git show main:x.txt
stdout '^x$'

# while the fix's session is still at work.
! exists .tmp/fix-go
exec kiln status
stdout '^notes: fix building, '

# Once that session ends its turn, the fix lands, and main holds both.
exec touch .tmp/fix-go
wait mon
exec git show main:note.txt
stdout '^noted$'
exec git show main:x.txt
stdout '^x$'

-- .kiln/kiln.json --
{"gate": ["true"], "monitors": [
 {"name": "notes", "every": "24h", "check": "sh .kiln/monitors/notes", "agent": ".kiln/agents/notes.md", "prompt": "Write the note."}
]}
-- .kiln/monitors/notes --
if [ -e note.txt ]; then
  echo '{"fix": false, "summary": "note.txt is there"}'
else
  echo '{"fix": true, "summary": "note.txt is missing"}'
fi
-- .kiln/agents/notes.md --
Write the missing note.
-- .kiln/specs/x.md --
### 1. X is there

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it says x.
-- _given/x/x.txt --
x
-- claude.json --
{
 "notes": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/.tmp/fixing\"; await \"$WORK/.tmp/fix-go\"; echo noted >note.txt"}}},
  {"result": {"result": "Wrote note.txt.\n{\"title\": \"fix(notes): write the missing note\"}"}}
 ]}},
 "build": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
  {"result": {"result": "Built x."}}
 ]}},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "2": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
 }
}
