# 3. kiln status shows both lanes at work, and a second kiln in a lane refuses.

env KILN_OPEN=true

# Given: kiln fire at work on a spec, and kiln monitor run at work on a fix. Each session touches a file, then waits
# for .tmp/go.
exec kiln queue x
exec kiln fire &fire&
exec sh -c 'i=0; while [ ! -e .tmp/building ] && [ $i -lt 1200 ]; do sleep 0.1; i=$((i+1)); done; [ -e .tmp/building ]'
exec kiln monitor run &mon&
exec sh -c 'i=0; while [ ! -e .tmp/fixing ] && [ $i -lt 1200 ]; do sleep 0.1; i=$((i+1)); done; [ -e .tmp/fixing ]'
grep -count=1 'ran' .tmp/check.log

# When: the developer runs kiln status,
exec kiln status

# Then: it shows the spec building, and the monitor's fix building.
stdout '^x: building'
stdout '^notes: fix building, '

# When: then kiln fire again,
! exec kiln fire

# Then: it refuses, naming the kiln fire that holds its lane, after the name of the command that refuses.
stderr ': .*kiln fire'

# When: and kiln monitor run again.
! exec kiln monitor run

# Then: it refuses, naming the kiln monitor run that holds its lane, after the name of the command that refuses.
stderr ': .*kiln monitor run'

# Neither starts a session, and no check runs.
! exists .claude-calls/build/2
! exists .claude-calls/build/1/2
! exists .claude-calls/fix/2
! exists .claude-calls/fix/1/2
grep -count=1 'ran' .tmp/check.log

# Both first kilns end once their sessions do.
exec touch .tmp/go
wait fire
wait mon

-- .kiln/kiln.json --
{"gate": ["true"]}
-- .kiln/monitors/notes/check --
echo ran >>"$WORK/.tmp/check.log"
if [ -e note.txt ]; then
  echo '{"fix": false, "summary": "note.txt is there"}'
else
  echo '{"fix": true, "summary": "note.txt is missing"}'
fi
-- .kiln/monitors/notes/agent.md --
Write the missing note.

Write the note.
-- .kiln/specs/x.md --
### 1. X is there

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it says x.
-- _given/x/x.txt --
x
-- claude.json --
{
 "fix": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/.tmp/fixing\"; i=0; while [ ! -e \"$WORK/.tmp/go\" ] && [ $i -lt 3000 ]; do sleep 0.1; i=$((i+1)); done; echo noted >note.txt"}}},
  {"result": {"result": "Wrote note.txt.\n{\"title\": \"fix(notes): write the missing note\"}"}}
 ]}},
 "build": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/.tmp/building\"; i=0; while [ ! -e \"$WORK/.tmp/go\" ] && [ $i -lt 3000 ]; do sleep 0.1; i=$((i+1)); done; cp -R \"$WORK/_given/x/.\" ."}}},
  {"result": {"result": "Built x."}}
 ]}},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "2": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
 }
}
