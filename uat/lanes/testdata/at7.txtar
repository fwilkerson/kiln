# 7. An accepted fix lands while a spec builds.

# Given: a monitor's fix waiting on its branch for kiln accept.
exec sh -c 'kiln monitor run || true'
exec kiln status
stdout '^notes: waiting on the developer'

# kiln fire is at work on a spec. Its build session touches .tmp/building, then waits for .tmp/build-go.
exec kiln queue x
exec kiln fire &fire&
exec sh -c 'i=0; while [ ! -e .tmp/building ] && [ $i -lt 1200 ]; do sleep 0.1; i=$((i+1)); done; [ -e .tmp/building ]'

# When: the developer runs kiln accept with the monitor's name.
exec kiln accept notes

# Then: the fix lands on main
exec git show main:note.txt
stdout '^noted$'

# while the build session is still at work.
! exists .tmp/build-go
exec kiln status
stdout '^x: building'

# The build's kiln ends once its session does.
exec touch .tmp/build-go
wait fire

-- .kiln/kiln.json --
{"gate": ["true"], "monitors": [
 {"name": "notes", "every": "24h", "check": "sh .kiln/monitors/notes", "agent": ".kiln/agents/notes.md", "prompt": "Write the note.", "accept": true}
]}
-- .kiln/monitors/notes --
if [ -e note.txt ]; then
  echo '{"fix": false, "summary": "note.txt is there"}'
else
  echo '{"fix": true, "summary": "note.txt is missing"}'
fi
-- .kiln/agents/notes.md --
Write the missing note.
-- .kiln/specs/x.md --
### 1. X is there

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it says x.
-- _given/x/x.txt --
x
-- claude.json --
{
 "notes": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "echo noted >note.txt"}}},
  {"result": {"result": "Wrote note.txt.\n{\"title\": \"fix(notes): write the missing note\"}"}}
 ]}},
 "build": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/.tmp/building\"; i=0; while [ ! -e \"$WORK/.tmp/build-go\" ] && [ $i -lt 3000 ]; do sleep 0.1; i=$((i+1)); done; cp -R \"$WORK/_given/x/.\" ."}}},
  {"result": {"result": "Built x."}}
 ]}},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "2": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
 }
}
