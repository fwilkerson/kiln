# 1. The verify session writes under each path, and the build session under none.

# Given: a project in the split workflow, whose kiln.json names the acceptance paths uat/{spec}/ and
# integration/{spec}/, and an approved spec x.

# When: the developer queues x and runs kiln fire. The build session writes a file under each path, and the verify
# session writes a test under each.
exec kiln queue x
exec kiln fire
cp stdout fire.out

# Then: kiln refuses each of the build session's two writes,
grep 'PreToolUse:Write hook error: [^"]*uat/x/mine_test\.go is the verify session''s' .claude-calls/build/1/1/stream.jsonl
grep 'PreToolUse:Write hook error: [^"]*integration/x/mine_test\.go is the verify session''s' .claude-calls/build/1/1/stream.jsonl
! exec git show main:uat/x/mine_test.go
! exec git show main:integration/x/mine_test.go

# and x lands on main with the verify session's tests under uat/x/ and integration/x/.
grep '^x: landed on main' fire.out
exec git show main:uat/x/x_test.go
stdout 'func TestAT1'
exec git show main:integration/x/x_test.go
stdout 'func TestAT1'

-- .kiln/kiln.json --
{"workflow": "split", "rounds": 3, "acceptance": ["uat/{spec}/", "integration/{spec}/"]}
-- claude.json --
{
  "build": {
    "1": {"1": [
      {"tool": {"name": "Write", "input": {"file_path": "uat/x/mine_test.go", "content": "package x_test\\n"}}},
      {"tool": {"name": "Write", "input": {"file_path": "integration/x/mine_test.go", "content": "package x_test\\n"}}},
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/code/.\" ."}}},
      {"result": {"result": "Built x."}}
    ]}
  },
  "verify": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests/.\" ."}}},
      {"result": {"result": "Wrote the tests of x."}}
    ]}
  },
  "audit": {"1": {"1": [{"result": {"result": "read 3 directories, found 0"}}]}}
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/tests/uat/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
-- _given/tests/integration/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
