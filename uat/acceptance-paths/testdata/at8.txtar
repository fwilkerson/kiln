# 8. Each session is told each path.

# Given: a project in the split workflow, whose kiln.json names the acceptance paths uat/{spec}/ and
# integration/{spec}/, and an approved spec x.
exec kiln queue x

# When: kiln fire builds x.
exec kiln fire
stdout '^x: landed on main'

# Then: the build session's and the verify session's instructions each name uat/x/ and integration/x/.
grep '`uat/x/`' .claude-calls/build/1/1/system
grep '`integration/x/`' .claude-calls/build/1/1/system
grep '`uat/x/`' .claude-calls/verify/1/1/system
grep '`integration/x/`' .claude-calls/verify/1/1/system

-- .kiln/kiln.json --
{"workflow": "split", "rounds": 3, "acceptance": ["uat/{spec}/", "integration/{spec}/"]}
-- claude.json --
{
  "build": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/code/.\" ."}}},
      {"result": {"result": "Built x."}}
    ]}
  },
  "verify": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests/.\" ."}}},
      {"result": {"result": "Wrote the tests of x."}}
    ]}
  },
  "audit": {"1": {"1": [{"result": {"result": "read 3 directories, found 0"}}]}}
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/tests/uat/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
-- _given/tests/integration/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
