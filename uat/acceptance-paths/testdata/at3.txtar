# 3. A revised spec's build starts without its old tests in every path.

# Given: a project in the split workflow, whose kiln.json names the acceptance paths uat/{spec}/ and
# integration/{spec}/. A spec landed, with its tests under both paths on main. The developer revised a Then and queued
# it again.
exec kiln queue x
exec kiln fire
stdout '^x: landed on main'
exec git show main:uat/x/x_test.go
stdout 'want 42'
exec git show main:integration/x/x_test.go
stdout 'want 42'
exec sed -i '' 's/it answers 42\./it answers 43./' .kiln/specs/x.md
exec git commit --quiet -am 'docs(x): revise test 1'
exec kiln queue x

# When: kiln fire builds it.
# kiln.json gives the build no round, so a gate that failed once would stop it.
exec kiln fire

# Then: the build session's checkout holds no file under either of the spec's paths,
exists .claude-calls/build-listed
grep '^x\.go$' .claude-calls/build-listed
! grep '^uat/x/' .claude-calls/build-listed
! grep '^integration/x/' .claude-calls/build-listed

# its gate runs none of the old tests, which fail on the revised code,
stdout '^x: landed on main'
! stdout 'the gate failed'

# and the spec lands with the verify session's new tests under both paths.
exec git show main:uat/x/x_test.go
stdout 'want 43'
exec git show main:integration/x/x_test.go
stdout 'want 43'
exec git show main:x.go
stdout 'return 43'

-- .kiln/kiln.json --
{"workflow": "split", "rounds": 0, "acceptance": ["uat/{spec}/", "integration/{spec}/"]}
-- claude.json --
{
  "build": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/code/.\" ."}}},
      {"result": {"result": "Built x."}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "git ls-files --cached --others >\"$WORK/.claude-calls/build-listed\""}}},
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/code43/.\" ."}}},
      {"result": {"result": "Built x again."}}
    ]}
  },
  "verify": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests/.\" ."}}},
      {"result": {"result": "Wrote the tests of x."}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests43/.\" ."}}},
      {"result": {"result": "Wrote the tests of x again."}}
    ]}
  },
  "audit": {
    "1": {"1": [{"result": {"result": "read 3 directories, found 0"}}]},
    "2": {"1": [{"result": {"result": "read 3 directories, found 0"}}]}
  }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/code43/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 43.
func X() int { return 43 }
-- _given/tests/uat/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
-- _given/tests/integration/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
-- _given/tests43/uat/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 43 {
		t.Fatalf("X answers %d, want 43", got)
	}
}
-- _given/tests43/integration/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 43 {
		t.Fatalf("X answers %d, want 43", got)
	}
}
