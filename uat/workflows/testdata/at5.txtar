# 5. The build session cannot change a proved test.
# x builds under verify-first, then y under build-and-verify.

# Given: a spec whose build session changes a file under the spec's acceptance path, and the spec's amendment file.
# Its first run writes a test file and the amendment file with the Write tool, then the test file by a shell
# command. Its second run removes that file and writes the amendment file by a shell command. Its third removes it.
exec kiln queue x

# When: the session writes each, or a shell command does and the gate runs.
exec kiln fire
stdout '^x: landed on main'

# Then: kiln refuses each write,
grep 'PreToolUse:Write hook error: [^"]*acceptance/x/mine_test\.go' .claude-calls/build/1/1/stream.jsonl
grep 'PreToolUse:Write hook error: [^"]*\.kiln/specs/x\.amend\.md' .claude-calls/build/1/1/stream.jsonl

# the gate fails on each change,
exec jq -se --arg s x '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | map(select(.build==$b and .kind=="gate" and .proof!=true and .landing!=true)) | length >= 3 and .[0].passed!=true and .[1].passed!=true and .[2].passed==true' .git/kiln/ledger.jsonl
grep 'acceptance/x/mine_test\.go' .claude-calls/build/1/2/prompt
grep 'x\.amend\.md' .claude-calls/build/1/3/prompt

# and main never holds either.
exec git log --format=%h main -- acceptance/x/mine_test.go .kiln/specs/x.amend.md
! stdout .
exec git show main:acceptance/x/x_test.go
cmp stdout _given/x/acceptance/x/x_test.go

# The same holds side by side.
exec sed -i '' 's/"verify-first"/"build-and-verify"/' .kiln/kiln.json
exec git commit --quiet -am 'chore: build side by side'
exec kiln queue y
exec kiln fire
stdout '^y: landed on main'
grep 'PreToolUse:Write hook error: [^"]*acceptance/y/mine_test\.go' .claude-calls/build/2/1/stream.jsonl
grep 'PreToolUse:Write hook error: [^"]*\.kiln/specs/y\.amend\.md' .claude-calls/build/2/1/stream.jsonl
exec jq -se --arg s y '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | map(select(.build==$b and .kind=="gate" and .proof!=true and .landing!=true)) | length >= 3 and .[0].passed!=true and .[1].passed!=true and .[2].passed==true' .git/kiln/ledger.jsonl
grep 'acceptance/y/mine_test\.go' .claude-calls/build/2/2/prompt
grep 'y\.amend\.md' .claude-calls/build/2/3/prompt
exec git log --format=%h main -- acceptance/y/mine_test.go .kiln/specs/y.amend.md
! stdout .
exec git show main:acceptance/y/y_test.go
cmp stdout _given/y/acceptance/y/y_test.go

-- .kiln/kiln.json --
{"workflow": "verify-first", "rounds": 3}
-- claude.json --
{
  "verify": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
      {"result": {"result": "Wrote the tests of x."}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y/.\" ."}}},
      {"result": {"result": "Wrote the tests of y."}}
    ]}
  },
  "build": {
    "1": {
      "1": [
        {"tool": {"name": "Write", "input": {"file_path": "acceptance/x/mine_test.go", "content": "package x_test\n"}}},
        {"tool": {"name": "Write", "input": {"file_path": ".kiln/specs/x.amend.md", "content": "## Acceptance test 1: x.txt answers\n"}}},
        {"tool": {"name": "Bash", "input": {"command": "echo 42 >x.txt && mkdir -p acceptance/x && printf 'package x_test\\n' >acceptance/x/mine_test.go"}}},
        {"result": {"result": "Built x."}}
      ],
      "2": [
        {"tool": {"name": "Bash", "input": {"command": "rm acceptance/x/mine_test.go && echo '## Acceptance test 1: x.txt answers' >.kiln/specs/x.amend.md"}}},
        {"result": {"result": "Removed the test file."}}
      ],
      "3": [
        {"tool": {"name": "Bash", "input": {"command": "rm .kiln/specs/x.amend.md"}}},
        {"result": {"result": "Removed the amendment file."}}
      ]
    },
    "2": {
      "1": [
        {"tool": {"name": "Write", "input": {"file_path": "acceptance/y/mine_test.go", "content": "package y_test\n"}}},
        {"tool": {"name": "Write", "input": {"file_path": ".kiln/specs/y.amend.md", "content": "## Acceptance test 1: y.txt answers\n"}}},
        {"tool": {"name": "Bash", "input": {"command": "echo 42 >y.txt && mkdir -p acceptance/y && printf 'package y_test\\n' >acceptance/y/mine_test.go"}}},
        {"result": {"result": "Built y."}}
      ],
      "2": [
        {"tool": {"name": "Bash", "input": {"command": "rm acceptance/y/mine_test.go && echo '## Acceptance test 1: y.txt answers' >.kiln/specs/y.amend.md"}}},
        {"result": {"result": "Removed the test file."}}
      ],
      "3": [
        {"tool": {"name": "Bash", "input": {"command": "rm .kiln/specs/y.amend.md"}}},
        {"result": {"result": "Removed the amendment file."}}
      ]
    }
  },
  "audit": {
    "1": {"1": [{"result": {"audit": {"read": 1}}}]},
    "2": {"1": [{"result": {"audit": {"read": 1}}}]}
  }
}
-- doc.go --
// Package scratch is where kiln's builds land.
package scratch
-- .kiln/specs/x.md --
### 1. x.txt answers

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it holds 42.
-- .kiln/specs/y.md --
### 1. y.txt answers

- **Given**: nothing.
- **When**: the developer reads y.txt.
- **Then**: it holds 42.
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../x.txt"); string(b) != "42\n" {
		t.Fatalf("x.txt holds %q, want 42", b)
	}
}
-- _given/y/acceptance/y/y_test.go --
package y_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../y.txt"); string(b) != "42\n" {
		t.Fatalf("y.txt holds %q, want 42", b)
	}
}
