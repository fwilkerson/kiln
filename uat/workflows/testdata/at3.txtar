# 3. Tests that pass on main go back to the verify session.
# The test names no workflow: x builds under verify-first, then y under build-and-verify.

# Given: a queued spec, whose verify session first writes a test that passes on main's code.
# The first test only reads go.mod. The second reads x.txt, which main lacks, and the build session writes.
exec kiln queue x

# When: kiln fire builds it.
exec kiln fire
stdout '^x: landed on main'

# Then: the verify session gets the proof gate's report as a round,
exists .claude-calls/verify/1/2/prompt
exec kiln ledger --kind gate --name x
stdout '"passed":true[^\n]*"proof":true'
exec jq -se --arg s x '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | any(.[]; .build==$b and .kind=="start" and .role=="verify" and .why=="no test" and .round==1)' .git/kiln/ledger.jsonl

# and no gate of both sessions' work runs before a proof gate fails.
exec jq -se --arg s x 'def at(f): map(f) | index(true); (map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | map(select(.build==$b)) | at(.kind=="gate" and .proof==true and .passed==true) as $q | at(.kind=="gate" and .proof==true and .passed!=true) as $p | at(.kind=="gate" and .proof!=true) as $g | $q != null and $p != null and $g != null and $q < $p and $p < $g' .git/kiln/ledger.jsonl

# The same holds side by side.
exec sed -i '' 's/"verify-first"/"build-and-verify"/' .kiln/kiln.json
exec git commit --quiet -am 'chore: build side by side'
exec kiln queue y
exec kiln fire
stdout '^y: landed on main'
exists .claude-calls/verify/2/2/prompt
exec kiln ledger --kind gate --name y
stdout '"passed":true[^\n]*"proof":true'
exec jq -se --arg s y '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | any(.[]; .build==$b and .kind=="start" and .role=="verify" and .why=="no test" and .round==1)' .git/kiln/ledger.jsonl
exec jq -se --arg s y 'def at(f): map(f) | index(true); (map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | map(select(.build==$b)) | at(.kind=="gate" and .proof==true and .passed==true) as $q | at(.kind=="gate" and .proof==true and .passed!=true) as $p | at(.kind=="gate" and .proof!=true) as $g | $q != null and $p != null and $g != null and $q < $p and $p < $g' .git/kiln/ledger.jsonl

-- .kiln/kiln.json --
{"workflow": "verify-first", "rounds": 3}
-- claude.json --
{
  "verify": {
    "1": {
      "1": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/passes/x/.\" ."}}},
        {"result": {"result": "Wrote the tests of x."}}
      ],
      "2": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/fails/x/.\" ."}}},
        {"result": {"result": "TestAT1 now reads x.txt."}}
      ]
    },
    "2": {
      "1": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/passes/y/.\" ."}}},
        {"result": {"result": "Wrote the tests of y."}}
      ],
      "2": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/fails/y/.\" ."}}},
        {"result": {"result": "TestAT1 now reads y.txt."}}
      ]
    }
  },
  "build": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo 42 >x.txt"}}},
      {"result": {"result": "Built x."}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo 42 >y.txt"}}},
      {"result": {"result": "Built y."}}
    ]}
  },
  "audit": {
    "1": {"1": [{"result": {"audit": {"read": 1}}}]},
    "2": {"1": [{"result": {"audit": {"read": 1}}}]}
  }
}
-- doc.go --
// Package scratch is where kiln's builds land.
package scratch
-- .kiln/specs/x.md --
### 1. x.txt answers

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it holds 42.
-- .kiln/specs/y.md --
### 1. y.txt answers

- **Given**: nothing.
- **When**: the developer reads y.txt.
- **Then**: it holds 42.
-- _given/passes/x/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if _, err := os.ReadFile("../../go.mod"); err != nil {
		t.Fatal(err)
	}
}
-- _given/fails/x/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../x.txt"); string(b) != "42\n" {
		t.Fatalf("x.txt holds %q, want 42", b)
	}
}
-- _given/passes/y/acceptance/y/y_test.go --
package y_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if _, err := os.ReadFile("../../go.mod"); err != nil {
		t.Fatal(err)
	}
}
-- _given/fails/y/acceptance/y/y_test.go --
package y_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../y.txt"); string(b) != "42\n" {
		t.Fatalf("y.txt holds %q, want 42", b)
	}
}
