# 1. In turn, the build session starts once the tests are proved.

# Given: a project whose kiln.json says "workflow": "verify-first", and a queued spec.
# The verify session's test reads x.txt, which main lacks, so it fails on main. The build session writes x.txt.
exec kiln queue x

# When: kiln fire builds it.
exec kiln fire
stdout '^x: landed on main'

# Then: the ledger shows a proof gate that failed before the build session's first run,
exec kiln ledger --kind gate --name x
stdout '"passed":false[^\n]*"proof":true'
exec jq -se --arg s x 'def at(f): map(f) | index(true); (map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | map(select(.build==$b)) | at(.kind=="gate" and .proof==true and .passed!=true) as $p | at(.kind=="start" and .role=="build") as $r | $p != null and $r != null and $p < $r' .git/kiln/ledger.jsonl

# and the spec waits for UAT with both sessions' files on main.
exec kiln status
stdout '^x: waiting for UAT$'
exec git show main:x.txt
stdout '^42$'
exec git show main:acceptance/x/x_test.go
stdout 'func TestAT1'

-- .kiln/kiln.json --
{"workflow": "verify-first"}
-- claude.json --
{
  "verify": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests/.\" ."}}},
    {"result": {"result": "Wrote the tests of x."}}
  ]}},
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "echo 42 >x.txt"}}},
    {"result": {"result": "Built x."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"audit": {"read": 1}}}]}}
}
-- .kiln/specs/x.md --
### 1. x.txt answers

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it holds 42.
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../x.txt"); string(b) != "42\n" {
		t.Fatalf("x.txt holds %q, want 42", b)
	}
}
-- doc.go --
// Package scratch is where kiln's builds land.
package scratch
