# 14. Each session's prompt holds only its own work

# Given: a project whose agents' files kiln init wrote, and a spec queued under each workflow.
exec kiln init
exec git add -A
exec git commit --quiet -m 'chore: start kiln'
mkdir .kiln/specs
exec sh -c 'sed -e "s/^Status: Proposed/Status: Approved, 2026-11-12/" -e "s/<Title>/X answers/" .kiln/skills/shape/template.md >.kiln/specs/x.md'
exec sh -c 'sed -e "s/^Status: Proposed/Status: Approved, 2026-11-12/" -e "s/<Title>/Y answers/" .kiln/skills/shape/template.md >.kiln/specs/y.md'
exec git add .kiln/specs
exec git commit --quiet -m 'docs: approve x and y'

# When: kiln fire builds each.
# x builds in build then audit, as kiln init wrote kiln.json. Then main's kiln.json names the split workflow, and y
# builds in it.
exec kiln queue x
exec kiln fire
stdout '^x: landed on main'
exec sh -c 'sed -i "" "s/^{/{\n  \"workflow\": \"split\",/" .kiln/kiln.json'
exec git commit --quiet -am 'chore: build in the split workflow'
exec kiln queue y
exec kiln fire
stdout '^y: landed on main'

# Then: under build then audit, the build session's prompt says how to write the acceptance tests.
grep '^## Acceptance tests$' .claude-calls/build/1/1/system
grep '`TestAT<N>`' .claude-calls/build/1/1/system
grep 'in `acceptance/x/`' .claude-calls/build/1/1/system

# Under split, the verify session's prompt says it,
grep '^## Acceptance tests$' .claude-calls/verify/1/1/system
grep '`TestAT<N>`' .claude-calls/verify/1/1/system
grep 'in `acceptance/y/`' .claude-calls/verify/1/1/system

# and the build session's prompt does not.
! grep 'Acceptance tests' .claude-calls/build/2/1/system
! grep 'TestAT' .claude-calls/build/2/1/system
! grep 'acceptance tests'' code' .claude-calls/build/2/1/system
grep 'A verify session writes the code of its acceptance tests' .claude-calls/build/2/1/system

-- go.mod --
module example.com/scratch

go 1.27
-- scratch.go --
// Package scratch is where kiln's builds land.
package scratch
-- claude.json --
{
  "build": {
    "1": {"1": [{"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}}, {"result": {"result": "Built x."}}]},
    "2": {"1": [{"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y/.\" ."}}}, {"result": {"result": "Built y."}}]}
  },
  "verify": {
    "1": {"1": [{"result": {"result": "Wrote the tests of y."}}]}
  },
  "audit": {
    "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
    "2": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
  }
}
-- _given/x/x.go --
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/y/y.go --
package scratch

// Y answers 7.
func Y() int { return 7 }
