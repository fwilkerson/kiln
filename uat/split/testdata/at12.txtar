# 12. A revised spec's build session starts without its old tests

# Given: a split spec landed, its acceptance tests are on main, and the developer revised a Then and queued it again.
exec kiln queue x
exec kiln fire
stdout '^x: landed on main'
exec git show main:acceptance/x/x_test.go
stdout 'want 42'
exec sed -i '' 's/it answers 42\./it answers 43./' .kiln/specs/x.md
exec git commit --quiet -am 'docs(x): revise test 1'
exec kiln queue x

# When: kiln fire builds it.
# kiln.json gives the build no round, so a gate that failed once would stop it.
exec kiln fire

# Then: the build session's checkout holds no file under the spec's acceptance path,
exists .claude-calls/build-listed
! grep '^acceptance/' .claude-calls/build-listed
grep '^x\.go$' .claude-calls/build-listed

# its gate never runs the old tests,
stdout '^x: landed on main'
! stdout 'the gate failed'

# and the spec lands with the verify session's tests.
exec git show main:acceptance/x/x_test.go
stdout 'want 43'
exec git show main:x.go
stdout 'return 43'

