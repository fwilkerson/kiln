# 7. A landed build leaves no checkout

# Given: the project chooses the split workflow, and a spec is queued.
exec kiln queue x

# When: kiln fire lands the spec.
exec kiln fire
stdout '^x: building on kiln/x\.build, in [^\n]*/\.build-x, and verifying on kiln/x\.verify, in [^\n]*/\.verify-x$'
stdout '^x: landed on main'

# Then: none of the clones and worktrees the build made remains, but the .main worktree every gate shares.
exec sh -c 'ls -A "$HOME"/Library/Caches/kiln/*/'
stdout '^\.main$'
! stdout '^\.build-x$'
! stdout '^\.verify-x$'
! stdout '^\.audit-x$'
! stdout '^x$'
exec git worktree list --porcelain
! stdout '/x$'
! stdout 'audit'
exec git branch --list 'kiln/*'
! stdout .

