# 4. A bug the verify session reports goes to the build session

# Given: the project chooses the split workflow, and the verify session's test fails against the build session's code.
# The build session's code answers 41, where the spec says 42.
exec kiln queue x

# When: kiln run gates the stack, and the verify session reports that the code is at fault.
exec kiln fire
stdout '^x: landed on main'

# Then: the build session gets the verify session's report and the failing test's Given, When, Then,
grep 'X answered 41 where the spec expects 42\.' .claude-calls/build/1/2/prompt
grep '\*\*Given\*\*: nothing\.' .claude-calls/build/1/2/prompt
grep '\*\*When\*\*: X is called\.' .claude-calls/build/1/2/prompt
grep '\*\*Then\*\*: it answers 42\.' .claude-calls/build/1/2/prompt

# but not the gate's report,
grep 'exited 1' .claude-calls/verify/1/2/prompt
! grep 'exited' .claude-calls/build/1/2/prompt
! grep 'FAIL' .claude-calls/build/1/2/prompt
! grep 'want 42' .claude-calls/build/1/2/prompt

# and the build has used one round.
stdout '^  1 of 3 rounds'
exec git show main:x.go
stdout 'return 42'

