# An approved spec lands, and kiln says so.

# Given: an approved spec whose build makes its acceptance tests pass.
# Its session costs $0.30, and one of its calls reads a file that is not there. Its first audit ends with no result,
# and runs again, for $0.12. Its finding goes back to the session, which fixes it.
exec kiln queue x

# When: the developer runs kiln fire.
exec kiln fire
cp stdout .tmp/run
stdout '^x: landed on main'

# Then: its output holds one notification, which names the spec and the state kiln status shows for it, waiting for
# UAT.
stdout -count=1 '\x1b\]9;'
stdout '^\x1b\]9;kiln: x waiting for UAT\x07'

# main holds the build's work,
exec git log -1 --format=%s main
stdout '^feat\(x\): land the approved spec$'
exec git diff --quiet main
exists x.go
cmp acceptance/x/x_test.go _given/x/acceptance/x/x_test.go

# its acceptance tests pass there,
exec go test ./acceptance/x/
stdout '^ok'

# and kiln status shows it waiting for UAT.
exec kiln status
stdout '^x: waiting for UAT$'
! stdout 'stopped|amendments'

# kiln ledger prints the build for a script, with the sums its summary shows.
exec kiln ledger --kind build --name x
stdout -count=1 '^\{'
stdout '^\{"kind":"build","build":"[a-z0-9]{12}","name":"x","fix":false,.*"outcome":"landed","seconds":[0-9.]+,"cost_usd":0\.42,"turns":3,"failed_calls":1,"rounds":0,"audits":1,"findings":1\}$'

# Its first gate ran the gate's commands at main too. Its landing's gate read the checks kept there.
exec kiln ledger --kind gate --name x
stdout '\A\{"kind":"gate",[^\n]*"landing":false,"ran_main":true\}\n'
stdout '"landing":true,"ran_main":false\}\n\z'

# The first audit ended with no result, so it ran again. Its finding went back to the session, which fixed it
# before the work landed.
exists .claude-calls/audit/2/1/call.json
grep 'x.go:3  false comment' .claude-calls/build/1/2/prompt
exec git show main:x.go
stdout '^// X answers 42.$'

# After the line that says the build landed, the output shows the build's time, cost, turns and failed calls, its
# rounds, the files it changed, and the command that accepts the spec.
exec cat .tmp/run
stdout '(?s)^x: landed on main at [0-9a-f]{12}, and waits for UAT$\n\x1b\]9;[^\x07]*\x07  [^·\n]+ · \$0\.42 · 3 turns · 1 failed call$'
stdout '(?s)^x: landed on main at .*^  0 of 1 round · the audit sent findings back$'
stdout '(?s)^x: landed on main at .*^  2 files changed, 18 insertions, 0 deletions$'
stdout '(?s)^x: landed on main at .*^  next: .*kiln accept x\b'
exec git diff --shortstat main^ main
stdout '^ 2 files changed, 18 insertions\(\+\)$'

# The landing commit's message holds the build's time, cost, turns and failed calls.
exec git log -1 --format=%B main
stdout '^feat\(x\): land the approved spec$'
stdout '^Build: (\d+s|[\d.]+ min) · \$0\.42 · 3 turns · 1 failed call$'

# The audit read the build's work, and git worktree list names no audit worktree.
exec cat .tmp/run
stdout '^x: the audit reads \. acceptance/x$'
exists .claude-calls/audit/1/1/call.json
exec git worktree list
! stdout '\.audit-'

-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {
    "1": [
      {"tool": {"name": "Read", "input": {"file_path": "missing.go"}}},
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
      {"result": {"result": "Built x.", "cost_usd": 0.30}}
    ],
    "2": [
      {"tool": {"name": "Edit", "input": {"file_path": "x.go", "old_string": "answers 41", "new_string": "answers 42"}}},
      {"result": {"result": "The finding is fixed."}}
    ]
  }},
  "audit": {
    "1": {"1": [{"result": {"is_error": true, "api_error_status": 529, "result": "API Error: 529 Overloaded"}}]},
    "2": {"1": [
      {"result": {"result": "1. x.go:3  false comment\nreaches    the doc says 41\n\nread 2 packages, found 1", "cost_usd": 0.12}}
    ]}
  }
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 41.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
