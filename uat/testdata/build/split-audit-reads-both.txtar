# The audit reads the stack once its gate passes.

# Given: the project chooses the workflow build-and-verify, and the stack passes its gate.
# The build session changes the harness beside its code. The verify session writes its tests.
exec kiln queue x

# When: the audit runs.
exec kiln fire
stdout '^x: the audit reads \. acceptance/x harness$'
stdout '^x: landed on main'

# Then: the audit reads the directories of both sessions' files,
grep 'Audit these directories: `\.`, `acceptance/x`, `harness`\.' .claude-calls/audit/1/1/prompt

# its prompt names each harness file the build session changed,
grep 'harness/h\.go' .claude-calls/audit/1/1/prompt
grep 'The build session changed these files of the test harness[^\n]*harness/h\.go' .claude-calls/audit/1/1/prompt

# and its findings go to both sessions.
grep 'h\.go:3  weak test' .claude-calls/build/1/2/prompt
grep 'h\.go:3  weak test' .claude-calls/verify/1/2/prompt

-- .kiln/kiln.json --
{"workflow": "build-and-verify", "rounds": 3, "testHelpers": ["harness/"]}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ],
   "2": [
    {
     "result": {
      "result": "The finding is wrong: the harness checks what it did."
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/tests/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x."
     }
    }
   ],
   "2": [
    {
     "result": {
      "result": "My tests hold."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "audit": {"read": 3, "findings": [{"path": "harness/h.go", "line": 3, "kind": "weak test", "harm": "it checks nothing"}]}
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/code/harness/h.go --
// Package harness is what the acceptance tests run through.
package harness

// Ready is true.
const Ready = true
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"strings"
	"testing"
)

func TestAT1(t *testing.T) {
	code, err := os.ReadFile("../../x.go")
	if !strings.Contains(string(code), "return 42") {
		t.Fatalf("x.go does not answer 42, want 42: %v", err)
	}
}
