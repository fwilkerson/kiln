# A spec that main already meets stops.
# x builds under verify-first, then y under build-and-verify.

# Given: a queued spec, and main's code already does what each Then says.
# main's x.txt and y.txt hold 42. kiln.json gives each session one round.
exec kiln queue x

# When: kiln fire builds it, and the verify session, sent back once, changes no test.
exec kiln fire
cp stdout .tmp/x-fire
exists .claude-calls/verify/1/2/prompt
! exists .claude-calls/verify/1/3

# Then: the build stops, and kiln status says why.
grep '^x: stopped: the verify session changed no test after a proof that did not stand' .tmp/x-fire
! grep '^x: landed on main' .tmp/x-fire
exec kiln status
stdout '^x: stopped: the verify session changed no test after a proof that did not stand'

# Under verify-first, no build session has run.
! exists .claude-calls/build
exec jq -se --arg s x '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | any(.[]; .build==$b and .kind=="start" and .role=="build") | not' .git/kiln/ledger.jsonl

# Side by side, the build stops too.
exec sed -i '' 's/"verify-first"/"build-and-verify"/' .kiln/kiln.json
exec git commit --quiet -am 'chore: build side by side'
exec kiln queue y
exec kiln fire
stdout '^y: stopped: the verify session changed no test after a proof that did not stand'
! stdout '^y: landed on main'
exists .claude-calls/verify/2/2/prompt
! exists .claude-calls/verify/2/3
exec kiln status
stdout '^y: stopped: the verify session changed no test after a proof that did not stand'

-- .kiln/kiln.json --
{"workflow": "verify-first", "rounds": 1}
-- claude.json --
{
  "verify": {
    "1": {
      "1": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
        {"result": {"result": "Wrote the tests of x."}}
      ],
      "2": [{"result": {"result": "main already holds 42 in x.txt, so I changed no test."}}]
    },
    "2": {
      "1": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y/.\" ."}}},
        {"result": {"result": "Wrote the tests of y."}}
      ],
      "2": [{"result": {"result": "main already holds 42 in y.txt, so I changed no test."}}]
    }
  },
  "build": {
    "1": {"1": [{"result": {"result": "main already holds 42 in y.txt."}}]}
  },
  "audit": {
    "1": {"1": [{"result": {"audit": {"read": 1}}}]}
  }
}
-- doc.go --
// Package scratch is where kiln's builds land.
package scratch
-- x.txt --
42
-- y.txt --
42
-- .kiln/specs/x.md --
### 1. x.txt answers

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it holds 42.
-- .kiln/specs/y.md --
### 1. y.txt answers

- **Given**: nothing.
- **When**: the developer reads y.txt.
- **Then**: it holds 42.
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../x.txt"); string(b) != "42\n" {
		t.Fatalf("x.txt holds %q, want 42", b)
	}
}
-- _given/y/acceptance/y/y_test.go --
package y_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../y.txt"); string(b) != "42\n" {
		t.Fatalf("y.txt holds %q, want 42", b)
	}
}
