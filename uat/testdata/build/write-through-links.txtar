# The hook judges a write by where it lands, after each link in its path.

# Given: an approved spec whose build links its worktree to the main checkout's .kiln/ and to git's common
# directory, and a third link to its own .claude/. A link a to its own directory lengthens a path's spelling, and
# a link b names, relative to the worktree, a file beside the main checkout that does not exist yet. It writes
# through each link, and removes the links.

# When: the developer queues the spec and runs kiln.
exec kiln queue x
exec kiln fire

# Then: no write lands, and the hook refused each.
! exists .kiln/monitors/planted
! exists .git/hooks/post-commit
! exists ../planted
grep 'PreToolUse:Write hook error: .*k/monitors/planted is outside this build''s worktree' .claude-calls/build/1/1/stream.jsonl
grep 'PreToolUse:Write hook error: .*g/hooks/post-commit is outside this build''s worktree' .claude-calls/build/1/1/stream.jsonl
grep 'PreToolUse:Write hook error: .*/b is outside this build''s worktree' .claude-calls/build/1/1/stream.jsonl
grep 'PreToolUse:Write hook error: .claude/settings.local.json is a Claude Code settings file' .claude-calls/build/1/1/stream.jsonl

-- .kiln/kiln.json --
{"rounds": 0}
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "ln -s \"$WORK/.kiln\" k && ln -s \"$(git rev-parse --path-format=absolute --git-common-dir)\" g && mkdir -p .claude && ln -s .claude c"}}},
    {"tool": {"name": "Write", "input": {"file_path": "k/monitors/planted", "content": "#!/bin/sh\n"}}},
    {"tool": {"name": "Write", "input": {"file_path": "g/hooks/post-commit", "content": "#!/bin/sh\n"}}},
    {"tool": {"name": "Write", "input": {"file_path": "c/settings.local.json", "content": "{}"}}},
    {"tool": {"name": "Bash", "input": {"command": "ln -s . a && ln -s \"$(perl -MFile::Spec -e 'print File::Spec->abs2rel(@ARGV)' \"$(cd -P \"$WORK/..\" && pwd)/planted\" \"$(pwd -P)\")\" b"}}},
    {"tool": {"name": "Write", "input": {"file_path": "a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/a/b", "content": "#!/bin/sh\n"}}},
    {"tool": {"name": "Bash", "input": {"command": "rm k g c a b && cp -R \"$WORK/_given/x/.\" ."}}},
    {"result": {"result": "Built x."}}
  ]}}
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
