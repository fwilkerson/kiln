# 2. A build can't change what the developer approved.

# Given: a build that changes a Given, When, Then in specs/<name>.md, by an edit or by a shell command.
# The build of x changes its spec by a shell command, after the hook refused its Edit. The build of y changes its spec
# by an Edit that got past the hook.
exec kiln queue x
exec kiln queue y

# When: its gate runs.
exec kiln run
stdout '^x: the gate failed'
stdout '^y: the gate failed'

# Then: the gate fails,
exec kiln status
stdout '^x: stopped$'
stdout '^  .kiln/specs/x.md is under .kiln/'
stdout '^y: stopped$'
stdout '^  .kiln/specs/y.md is under .kiln/'

# and specs/<name>.md on main is as approved.
exec git show main:.kiln/specs/x.md
cmp stdout _given/approved/x.md
exec git show main:.kiln/specs/y.md
cmp stdout _given/approved/y.md

# The hook refused x's Edit before the shell command changed the spec.
grep 'PreToolUse:Edit hook error: .kiln/specs/x.md is under .kiln/' .claude-calls/build/1/1/stream.jsonl

-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- .kiln/specs/y.md --
### 1. Y answers

- **Given**: nothing.
- **When**: Y is called.
- **Then**: it answers 7.
-- claude.json --
{
  "build": {
    "1": {
      "1": [
        {"tool": {"name": "Edit", "input": {"file_path": ".kiln/specs/x.md", "old_string": "answers 42", "new_string": "answers 41"}}},
        {"tool": {"name": "Bash", "input": {"command": "sed -i '' 's/answers 42/answers 41/' .kiln/specs/x.md"}}},
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
        {"result": {"result": "Built x, to the spec as I changed it."}}
      ],
      "2": [{"result": {"result": "The spec as I changed it is the one I built."}}]
    },
    "2": {
      "1": [
        {"tool": {"name": "Edit", "raw": true, "input": {"file_path": ".kiln/specs/y.md", "old_string": "answers 7", "new_string": "answers 8"}}},
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y/.\" ."}}},
        {"result": {"result": "Built y, to the spec as I changed it."}}
      ],
      "2": [{"result": {"result": "The spec as I changed it is the one I built."}}]
    }
  }
}
-- _given/approved/x.md --
