# A build in build-and-verify lands the code and its tests, and leaves no checkout.

# Given: the project chooses the workflow build-and-verify, and a spec is queued.
exec kiln queue x

# When: kiln fire builds the spec, the build session writes its code, and the verify session writes its acceptance
# tests.
exec kiln fire
exists .claude-calls/build/1/1/call.json
exists .claude-calls/verify/1/1/call.json

# Then: kiln fire names the branch and checkout of each session,
stdout '^x: building on kiln/x\.build, in [^\n]*/\.build-x, and verifying on kiln/x\.verify, in [^\n]*/\.verify-x$'

# the spec waits for UAT,
stdout '^x: landed on main'
exec kiln status
stdout '^x: waiting for UAT$'

# and main holds both the build session's files and the verify session's.
exec git show main:x.go
stdout 'func X\(\) int \{ return 42 \}'
exec git show main:acceptance/x/x_test.go
stdout 'func TestAT1'

# None of the clones and worktrees the build made remains, but the .main worktree every gate shares.
exec sh -c 'ls -A "$HOME"/Library/Caches/kiln/*/'
stdout '^\.main$'
! stdout '^\.build-x$'
! stdout '^\.verify-x$'
! stdout '^\.audit-x$'
! stdout '^x$'
exec git worktree list --porcelain
! stdout '/x$'
! stdout 'audit'
exec git branch --list 'kiln/*'
! stdout .

-- .kiln/kiln.json --
{"workflow": "build-and-verify"}
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/code/.\" ."}}},
    {"result": {"result": "Built x."}}
  ]}},
  "verify": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests/.\" ."}}},
    {"result": {"result": "Wrote the tests of x."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"result": "read 2 directories, found 0, reported 0"}}]}}
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
