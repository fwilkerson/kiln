# A split build goes on in both its sessions.

# Given: a project that chooses the split workflow, and a spec whose build stopped, the stack's gate still failing
# after its last round, on a failure that a commit on main ends. The build session's X answers Base + 1, the verify
# session's test wants 42, and main's Base is 40.
exec kiln queue x
exec kiln fire
stdout '^x: stopped'
cp stdout .tmp/fire.out
exec sh -c 'ls .claude-calls/verify/1 | sort -n | tail -1'
cp stdout .tmp/verify-calls

# When: the developer runs kiln tend with the spec's name. The session makes that commit on main, setting Base to 41,
# and exits.
exec sh -c 'kiln tend x >.tmp/tend.out 2>&1 || true'
exec git log -1 --format=%s main -- base.go
stdout '^fix: set Base to 41$'

# Then: the session's first message names both of the build's sessions, each with its checkout.
exists .claude-calls/tend/1/1/prompt
grep '^Its sessions: build [0-9a-f-]+, in .+; verify [0-9a-f-]+, in .+$' .claude-calls/tend/1/1/prompt
exec sh -c 'for role in build verify; do sed -n "s/.*\"session_id\": \"\(.*\)\".*/$role \1/p" .claude-calls/$role/1/1/call.json; done'
cp stdout .tmp/ids
exec sh -c 'f=.claude-calls/tend/1/1/prompt && sed -n "s/^Its sessions: build \([0-9a-f-]*\), in .*$/build \1/p" $f && sed -n "s/^Its sessions: build .*; verify \([0-9a-f-]*\), in .*$/verify \1/p" $f'
cmp stdout .tmp/ids

# Each checkout is the one kiln fire named for that session's branch.
exec sh -c 'sed -n "s/^x: building on kiln\/x\.build, in \(.*\), and verifying on kiln\/x\.verify, in \(.*\)$/\1 \2/p" .tmp/fire.out'
stdout .
cp stdout .tmp/checkouts
exec sh -c 'f=.claude-calls/tend/1/1/prompt && echo "$(sed -n "s/^Its sessions: build [0-9a-f-]*, in \(.*\); verify .*$/\1/p" $f) $(sed -n "s/^Its sessions: build .*; verify [0-9a-f-]*, in \(.*\)$/\1/p" $f)"'
cmp stdout .tmp/checkouts

# kiln starts neither session anew: it resumes each.
! exists .claude-calls/build/2
! exists .claude-calls/verify/2
grep '"resume": ?true' .claude-calls/build/1/2/call.json
exec sh -c 'grep -l "\"resume\": true" .claude-calls/verify/1/$(( $(cat .tmp/verify-calls) + 1 ))/call.json'

# The work of both lands on main,
exec git show main:x.go
stdout 'return Base \+ 1'
exec git show main:acceptance/x/x_test.go
stdout 'want 42'

# and the spec waits for UAT.
exec kiln status
stdout '^x: waiting for UAT$'

-- .kiln/kiln.json --
{"workflow": "build-and-verify"}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- base.go --
// Package scratch is where kiln's builds land.
package scratch

// Base is what X builds on.
const Base = 40
-- _given/base.go --
// Package scratch is where kiln's builds land.
package scratch

// Base is what X builds on.
const Base = 41
-- claude.json --
{
 "build": {"1": {
  "1": [
   {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/code/.\" ."}}},
   {"result": {"result": "Built x."}}
  ],
  "2": [{"result": {"result": "Went on, as the developer said."}}],
  "3": [{"result": {"result": "Went on."}}]
 }},
 "verify": {"1": {
  "1": [
   {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests/.\" ."}}},
   {"result": {"result": "Wrote the tests of x."}}
  ],
  "2": [{"result": {"result": "X answers Base + 1, and Base is 40 on main.\nbugs: none"}}],
  "3": [{"result": {"result": "Went on, as the developer said.\nbugs: none"}}],
  "4": [{"result": {"result": "Went on.\nbugs: none"}}]
 }},
 "audit": {"1": {"1": [{"result": {"audit": {"read": 2}}}]}},
 "tend": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "cp \"$WORK/_given/base.go\" base.go && git add base.go && git commit -q -m 'fix: set Base to 41'"}}},
  {"exit": 0}
 ]}}
}
-- _given/code/x.go --
package scratch

// X answers one more than Base.
func X() int { return Base + 1 }
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
