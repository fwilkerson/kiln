# A stopped build keeps what the developer resumes.

# Given: the project chooses the split workflow, and the stack's gate fails past the last round.
# kiln.json gives the build 1 round, and the verify session's test expects 41 both times.
exec kiln queue x

# When: the build stops.
exec kiln fire
stdout '^x: stopped: the gate still failed after its last round'
cp stdout .claude-calls/run.out

# Then: both sessions' checkouts remain,
exec sh -c 'ls -A "$HOME"/Library/Caches/kiln/*/'
stdout '^\.build-x$'
stdout '^\.verify-x$'
stdout '^x$'
exec git branch --list 'kiln/*'
stdout 'kiln/x\.build'
stdout 'kiln/x\.verify'

# and the summary names kiln tend, whose session names each of the build's sessions.
grep 'next: run kiln tend x, ' .claude-calls/run.out

-- .kiln/kiln.json --
{"verifySession": true}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/wrong/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x."
     }
    }
   ],
   "2": [
    {
     "result": {
      "result": "My test holds.\nbugs: none"
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "result": "read 2 directories, found 0"
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/wrong/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 41 {
		t.Fatalf("X answers %d, want 41", got)
	}
}
