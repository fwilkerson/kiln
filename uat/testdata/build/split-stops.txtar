# A stopped build keeps what the developer resumes.

# Given: the project chooses the workflow build-and-verify, and the gate of the joined work fails past the last round.
# kiln.json gives the build 1 round. The verify session's test expects 41, and the build session's code answers 42
# both times.
exec kiln queue x

# When: the build stops.
exec kiln fire
stdout '^x: stopped: the gate still failed after its last round'
cp stdout .claude-calls/run.out

# Then: both sessions' checkouts remain,
exec sh -c 'ls -A "$HOME"/Library/Caches/kiln/*/'
stdout '^\.verify-x$'
stdout '^x$'
exec git branch --list 'kiln/*'
stdout 'kiln/x$'
stdout 'kiln/x\.verify'

# and the summary names kiln tend, whose session names each of the build's sessions.
grep 'next: run kiln tend x, ' .claude-calls/run.out

-- .kiln/kiln.json --
{"workflow": "build-and-verify"}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ],
   "2": [
    {
     "result": {
      "result": "My code holds."
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/wrong/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "audit": {"read": 2}
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/wrong/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"strings"
	"testing"
)

func TestAT1(t *testing.T) {
	code, err := os.ReadFile("../../x.go")
	if !strings.Contains(string(code), "return 41") {
		t.Fatalf("x.go does not answer 41: %v", err)
	}
}
