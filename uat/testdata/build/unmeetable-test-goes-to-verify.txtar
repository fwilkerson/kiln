  "verify": {
    "1": {
      "1": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x43/.\" ."}}},
        {"result": {"result": "Wrote the tests of x."}}
      ],
      "2": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x42/.\" ."}}},
        {"result": {"result": "TestAT1 wants 42 now, as the spec says."}}
      ],
      "3": [{"result": {"result": "The finding is wrong."}}]
    },
    "2": {
      "1": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y43/.\" ."}}},
        {"result": {"result": "Wrote the tests of y."}}
      ],
      "2": [
        {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y42/.\" ."}}},
        {"result": {"result": "TestAT1 wants 42 now, as the spec says."}}
      ],
      "3": [{"result": {"result": "The finding is wrong."}}]
    }
  },
  "build": {
    "1": {
      "1": [
        {"tool": {"name": "Bash", "input": {"command": "echo 42 >x.txt"}}},
        {"result": {"result": "Wrote x.txt. TestAT1 wants 43, and the spec says 42.\ncannot hold: 1"}}
      ],
      "2": [
        {"tool": {"name": "Bash", "input": {"command": "cat acceptance/x/x_test.go >>\"$WORK/.claude-calls/x-build-saw\""}}},
        {"result": {"result": "Built x."}}
      ],
      "3": [
        {"tool": {"name": "Bash", "input": {"command": "cat acceptance/x/x_test.go >>\"$WORK/.claude-calls/x-build-saw\""}}},
        {"result": {"result": "Built x."}}
      ]
    },
    "2": {
      "1": [
        {"tool": {"name": "Bash", "input": {"command": "echo 42 >y.txt"}}},
        {"result": {"result": "Built y."}}
      ],
      "2": [
        {"result": {"result": "TestAT1 wants 43, and the spec says 42.\ncannot hold: 1"}}
      ],
      "3": [
        {"tool": {"name": "Bash", "input": {"command": "cat acceptance/y/y_test.go >>\"$WORK/.claude-calls/y-build-saw\""}}},
        {"result": {"result": "Built y."}}
      ],
      "4": [
        {"tool": {"name": "Bash", "input": {"command": "cat acceptance/y/y_test.go >>\"$WORK/.claude-calls/y-build-saw\""}}},
        {"result": {"result": "Built y."}}
      ]
    }
  },
  "audit": {
    "1": {"1": [{"result": {"audit": {"read": 1, "findings": [{"path": "acceptance/x/x_test.go", "line": 9, "kind": "weak test", "reaches": "TestAT1 checks one clause"}]}}}]},
    "2": {"1": [{"result": {"audit": {"read": 1, "findings": [{"path": "acceptance/y/y_test.go", "line": 9, "kind": "weak test", "reaches": "TestAT1 checks one clause"}]}}}]}
  }
}
-- doc.go --
// Package scratch is where kiln's builds land.
package scratch
-- .kiln/specs/x.md --
### 1. x.txt answers

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it holds 42.
-- .kiln/specs/y.md --
### 1. y.txt answers

- **Given**: nothing.
- **When**: the developer reads y.txt.
- **Then**: it holds 42.
-- _given/x43/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../x.txt"); string(b) != "43\n" {
		t.Fatalf("x.txt holds %q, want 43", b)
	}
}
-- _given/x42/acceptance/x/x_test.go --
