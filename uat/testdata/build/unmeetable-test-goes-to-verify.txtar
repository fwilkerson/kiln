# A test the build session cannot meet goes to the verify session.
# x builds under verify-first, then y under build-and-verify.

# Given: a spec whose proved test expects what the spec does not say, and whose build session says the test cannot
# hold.
# The spec says 42, and the verify session's first test wants 43. Its second wants 42. The audit sends a finding, so
# the build session runs once the verify session has answered it. At each of its later runs, the build session
# keeps the test it finds in its checkout.
exec kiln queue x

# When: kiln fire goes on.
exec kiln fire
cp stdout .tmp/x-fire

# Then: the verify session gets the build session's reply,
grep 'TestAT1 wants 43, and the spec says 42' .claude-calls/verify/1/2/prompt

# kiln proves its changed tests again,
exec jq -se --arg s x '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | map(select(.build==$b)) | [to_entries[] | select(.value.kind=="start" and .value.role=="verify") | .key][1] as $v | $v != null and ([to_entries[] | select(.key > $v and .value.kind=="gate" and .value.proof==true and .value.passed!=true)] | length >= 1)' .git/kiln/ledger.jsonl

# the build session's checkout holds them,
grep 'want 42' .claude-calls/x-build-saw
! grep 'want 43' .claude-calls/x-build-saw

# and the work lands.
grep '^x: landed on main' .tmp/x-fire
exec git show main:acceptance/x/x_test.go
stdout 'want 42'

# The same holds side by side. There the build session first runs blind, and says the test cannot hold once the
# gate of the joined work fails.
exec sed -i '' 's/"verify-first"/"build-and-verify"/' .kiln/kiln.json
exec git commit --quiet -am 'chore: build side by side'
exec kiln queue y
exec kiln fire
cp stdout .tmp/y-fire
grep 'TestAT1 wants 43, and the spec says 42' .claude-calls/verify/2/2/prompt
exec jq -se --arg s y '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | map(select(.build==$b)) | [to_entries[] | select(.value.kind=="start" and .value.role=="verify") | .key][1] as $v | $v != null and ([to_entries[] | select(.key > $v and .value.kind=="gate" and .value.proof==true and .value.passed!=true)] | length >= 1)' .git/kiln/ledger.jsonl
grep 'want 42' .claude-calls/y-build-saw
! grep 'want 43' .claude-calls/y-build-saw
grep '^y: landed on main' .tmp/y-fire
exec git show main:acceptance/y/y_test.go
stdout 'want 42'

-- .kiln/kiln.json --
{"workflow": "verify-first", "rounds": 3}
-- claude.json --
