# A build queued under one acceptance path builds with that path, though main names two by then.

# Given: a project in the workflow build-and-verify, and a spec x queued while kiln.json names its acceptance path as the string
# "uat/{spec}/". Main's kiln.json then changes to the list ["uat/{spec}/", "integration/{spec}/"].
exec kiln queue x
cp _given/kiln.json .kiln/kiln.json
exec git commit --quiet -am 'chore: name two acceptance paths'

# When: kiln fire builds x, and its build session writes a file under uat/x/ and one under integration/x/.
exec kiln fire
cp stdout fire.out

# Then: kiln refuses the write under uat/x/,
grep 'PreToolUse:Write hook error: [^"]*uat/x/mine_test\.go is the verify session''s' .claude-calls/build/1/1/stream.jsonl
! exec git show main:uat/x/mine_test.go

# and x lands on main with the build session's file under integration/x/.
grep '^x: landed on main' fire.out
exec git show main:integration/x/notes.txt
stdout '^written by the build session$'

-- .kiln/kiln.json --
{"workflow": "build-and-verify", "rounds": 3, "acceptanceTests": "uat/{spec}/"}
-- _given/kiln.json --
{"workflow": "build-and-verify", "rounds": 3, "acceptanceTests": ["uat/{spec}/", "integration/{spec}/"], "gate": ["go vet ./...", "go test ./..."]}
-- claude.json --
{
  "build": {
    "1": {"1": [
      {"tool": {"name": "Write", "input": {"file_path": "uat/x/mine_test.go", "content": "package x_test\\n"}}},
      {"tool": {"name": "Write", "input": {"file_path": "integration/x/notes.txt", "content": "written by the build session\n"}}},
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/code/.\" ."}}},
      {"result": {"result": "Built x."}}
    ]}
  },
  "verify": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/tests/.\" ."}}},
      {"result": {"result": "Wrote the tests of x."}}
    ]}
  },
  "audit": {"1": {"1": [{"result": {"result": "read 3 directories, found 0, reported 0"}}]}}
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/tests/uat/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
