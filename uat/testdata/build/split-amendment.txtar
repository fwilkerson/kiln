# The build session learns of an amendment.

# Given: the project chooses the workflow build-and-verify, and the verify session amends a Given, When, Then.
exec kiln queue x

# When: the build session next runs.
# The audit sends a finding back, so it runs again.
exec kiln fire
stdout '^x: waits on kiln/x, with amendments for UAT'
exists .claude-calls/build/1/2/prompt

# Then: its prompt holds the amendment's new wording.
grep '\*\*Then\*\*: it answers 42, or more\.' .claude-calls/build/1/2/prompt
! grep 'it answers 42, or more' .claude-calls/build/1/1/prompt

-- .kiln/kiln.json --
{"workflow": "build-and-verify", "rounds": 3}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ],
   "2": [
    {
     "result": {
      "result": "The finding is wrong."
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/tests/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x, and amended test 1."
     }
    }
   ],
   "2": [
    {
     "result": {
      "result": "My tests hold."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "audit": {"read": 2, "findings": [{"path": "x.go", "line": 4, "kind": "false comment", "harm": "a stale doc"}]}
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"strings"
	"testing"
)

func TestAT1(t *testing.T) {
	code, err := os.ReadFile("../../x.go")
	if !strings.Contains(string(code), "return 42") {
		t.Fatalf("x.go does not answer 42, want 42: %v", err)
	}
}
-- _given/tests/.kiln/specs/x.amend.md --
## Acceptance test 1: X answers

### Old

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.

### New

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42, or more.

### Reason

A larger answer serves too.
