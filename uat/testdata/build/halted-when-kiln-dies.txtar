# A build whose kiln fire died shows as halted, and kiln fire takes it up again.

# Given: an approved spec whose build session kills its kiln fire, by the process ID kiln's state holds.
exec kiln queue x

# When: kiln fire dies mid-build.
! exec kiln fire
exists .tmp/killed

# Then: kiln status shows the build halted, and names kiln fire, which takes it up again.
exec kiln status
stdout '^x: halted\n  its kiln fire is gone: kiln fire takes it up again$'
! stdout 'building'

# kiln queue refuses it with the same words.
! exec kiln queue x
stderr 'it is halted, as its kiln fire is gone: kiln fire takes it up again'
! stderr 'once its build ends'

-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "mkdir -p \"$WORK/.tmp\" && touch \"$WORK/.tmp/killed\" && kill -9 $(sed -n 's/^ *.pid.: *\\([0-9]*\\).*/\\1/p' \"$(git rev-parse --git-common-dir)/kiln/state.json\")"}}},
    {"result": {"result": "Killed kiln."}}
  ]}}
}
