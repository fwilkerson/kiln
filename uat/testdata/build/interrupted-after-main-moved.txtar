# A build whose landing moved main waits for UAT, though Ctrl-C cut kiln short as main moved.

# Given: an approved spec whose build passes its gate. A git first on the PATH interrupts kiln, as Ctrl-C does, as
# soon as a fast-forward merge moves main, and returns only once kiln has seen the interrupt.
exec kiln queue x
exec sh -c 'printf "#!/bin/sh\n\"%s\" \"\$@\" || exit\ncase \" \$* \" in *\" merge \"*\" --ff-only \"*) [ -e \"$WORK/.tmp/killed\" ] || { touch \"$WORK/.tmp/killed\"; kill -INT \$PPID; sleep 2; } ;; esac\n" "$(command -v git)" >.tmp/git && chmod +x .tmp/git'

# When: kiln fire is interrupted once main holds the landing, and the developer runs kiln fire again.
exec sh -c 'PATH="$PWD/.tmp:$PATH" kiln fire || true'
exists .tmp/killed
exec git log -1 --format=%s main
stdout '^feat\(x\): land the approved spec$'
exec kiln fire
cp stdout .tmp/run
stdout '^x: landed on main'

# Then: kiln status shows it waiting for UAT,
exec kiln status
stdout '^x: waiting for UAT$'
! stdout 'stopped'

# no session ran again, and main holds the one landing.
! exists .claude-calls/build/1/2/call.json
exec git log -1 --format=%s main^
! stdout 'land the approved spec'

# The gauge read the landing against main as it stood before, and kiln dropped the branch and its worktree.
grep '^x: gauge changed: 2, line ≤ 10$' .tmp/run
! exec git rev-parse --verify --quiet kiln/x
exec git worktree list
! stdout 'kiln/x'

-- .kiln/kiln.json --
{"gauges": [{"name": "changed", "command": "git diff --name-only \"$KILN_BASE\" HEAD | wc -l", "max": 10}]}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
    {"result": {"result": "Built x."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"result": "read 1 directory, found 0"}}]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
