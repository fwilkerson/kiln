# A failure on the build session's side goes to the build session alone.

# Given: the project chooses the split workflow, and the build session's work fails a gate command on its own.
# Its first code does not compile.
exec kiln queue x

# When: kiln fire gates the build session's work.
exec kiln fire
stdout '^x: landed on main'

# Then: the build session gets the gate's report,
grep 'exited 1' .claude-calls/build/1/2/prompt
grep 'undefined: nothing' .claude-calls/build/1/2/prompt

# the verify session does not run again,
! exists .claude-calls/verify/1/2

# and the build has used one round.
stdout '^  1 of 3 rounds'

-- .kiln/kiln.json --
{"workflow": "split", "rounds": 3}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/broken/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ],
   "2": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Fixed x."
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/tests/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "result": "read 2 directories, found 0"
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/broken/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return nothing }
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
