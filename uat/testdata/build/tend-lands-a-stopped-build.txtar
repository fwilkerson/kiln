# A stopped build's tend session lands the work itself, and kiln goes on with nothing.
# Only the built binary shows: the session's own kiln tend --landed, run beside the kiln tend that opened it.

# Given: an approved spec whose build stopped, its gate failing. kiln.json gives the build no round.
exec kiln queue x
exec kiln fire
stdout '^x: stopped'

# When: the developer runs kiln tend with the spec's name. The session commits the work and its acceptance tests on
# main, runs kiln tend --landed, and exits.
exec kiln tend x

# Then: kiln goes on with nothing: it says the spec waits for UAT, and resumes no session of the build.
stdout '^x: it is waiting for UAT'
! exists .claude-calls/build/1/2
! exists .claude-calls/build/2

# main holds the work,
exec git show main:x.go
stdout 'return 42'
exec git show main:acceptance/x/x_test.go
stdout 'func TestAT1'

# and kiln status shows the spec waiting for UAT.
exec kiln status
stdout '^x: waiting for UAT$'

-- .kiln/kiln.json --
{"rounds": 0}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
 "build": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
  {"result": {"result": "Built x."}}
 ]}},
 "tend": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/done/.\" . && git add x.go acceptance && git commit -q -m 'feat(x): answer 42'"}}},
  {"tool": {"name": "Bash", "input": {"command": "kiln tend x --landed"}}},
  {"exit": 0}
 ]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 41.
func X() int { return 41 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
-- _given/done/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/done/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
