# A test the build session cannot meet goes to the verify session, whose answer kiln proves again.

# Given: the project chooses the workflow build-and-verify, and the verify session's test fails against the build session's code.
# The verify session's test expects 41, where the spec and the code say 42.
exec kiln queue x

# When: kiln fire gates the joined work, the build session says the test cannot hold, and the verify session fixes it.
exec kiln fire
stdout '^x: landed on main'

# Then: the verify session got the build session's reply,
grep 'cannot hold: 1' .claude-calls/verify/1/2/prompt
grep 'TestAT1 wants 41' .claude-calls/verify/1/2/prompt

# kiln proved its fixed test, and the build session did not run again,
grep -count=2 '"proof":true' .git/kiln/ledger.jsonl
! exists .claude-calls/build/1/3

# the build has used one round,
stdout '^  1 of 3 rounds'

# and the audit ran only after the joined work passed its gate.
# Its one run's start line follows a gate that passed; the failed gate came before it.
grep -count=1 '"role":"audit"' .git/kiln/ledger.jsonl
grep '"kind":"gate"[^\n]*\n(?:[^\n]*\n)*?[^\n]*"kind":"gate"[^\n]*"passed":true[^\n]*\n[^\n]*"role":"audit"' .git/kiln/ledger.jsonl

-- .kiln/kiln.json --
{"workflow": "build-and-verify", "rounds": 3}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ],
   "2": [
    {
     "result": {
      "result": "TestAT1 wants 41, where the spec says X answers 42.\ncannot hold: 1"
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/wrong/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x."
     }
    }
   ],
   "2": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/tests/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "My test misread the spec: it answers 42."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "audit": {"read": 2}
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/wrong/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"strings"
	"testing"
)

func TestAT1(t *testing.T) {
	code, err := os.ReadFile("../../x.go")
	if !strings.Contains(string(code), "return 41") {
		t.Fatalf("x.go does not answer 41, want 41: %v", err)
	}
}
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"strings"
	"testing"
)

func TestAT1(t *testing.T) {
	code, err := os.ReadFile("../../x.go")
	if !strings.Contains(string(code), "return 42") {
		t.Fatalf("x.go does not answer 42, want 42: %v", err)
	}
}
