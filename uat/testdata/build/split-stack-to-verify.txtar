# A failing stack goes to the verify session first.

# Given: the project chooses the split workflow, and the verify session's test fails against the build session's code.
# The verify session's test expects 41, where the spec and the code say 42.
exec kiln queue x

# When: kiln fire gates the stack, and the verify session fixes its test.
exec kiln fire
stdout '^x: landed on main'

# Then: the verify session got the gate's report,
grep 'want 41' .claude-calls/verify/1/2/prompt
grep 'exited 1' .claude-calls/verify/1/2/prompt

# the build session did not run before the next stack's gate,
! exists .claude-calls/build/1/2

# the build has used one round,
stdout '^  1 of 3 rounds'

# and the audit ran only after the stack passed.
# Its one run's start line follows a gate that passed; the stack's failed gate came before it.
grep -count=1 '"role":"audit"' .git/kiln/ledger.jsonl
grep '"kind":"gate"[^\n]*\n(?:[^\n]*\n)*?[^\n]*"kind":"gate"[^\n]*"passed":true[^\n]*\n[^\n]*"role":"audit"' .git/kiln/ledger.jsonl

-- .kiln/kiln.json --
{"workflow": "split", "rounds": 3}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/wrong/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x."
     }
    }
   ],
   "2": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/tests/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "My test misread the spec: it answers 42.\nbugs: none"
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "result": "read 2 directories, found 0"
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/wrong/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 41 {
		t.Fatalf("X answers %d, want 41", got)
	}
}
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
