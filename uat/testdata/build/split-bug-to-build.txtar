# A failed gate of the work joined with the proved tests goes to the build session alone.

# Given: the project chooses the workflow build-and-verify, and the verify session's test fails against the build session's code.
# The build session's code answers 41, where the spec says 42.
exec kiln queue x

# When: kiln fire proves the tests, joins them into the build session's work, and gates it.
exec kiln fire
stdout '^x: landed on main'

# Then: the build session gets the gate's report, with the joined tests' file,
grep 'exited 1' .claude-calls/build/1/2/prompt
grep 'acceptance/x/x_test\.go' .claude-calls/build/1/2/prompt

# the verify session runs once,
! exists .claude-calls/verify/1/2

# and the build has used one round.
stdout '^  1 of 3 rounds'
exec git show main:x.go
stdout 'return 42'

-- .kiln/kiln.json --
{"workflow": "build-and-verify", "rounds": 3}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/bug/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ],
   "2": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Fixed X."
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/tests/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "audit": {"read": 2}
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/bug/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 41.
func X() int { return 41 }
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"strings"
	"testing"
)

func TestAT1(t *testing.T) {
	code, err := os.ReadFile("../../x.go")
	if !strings.Contains(string(code), "return 42") {
		t.Fatalf("x.go does not answer 42, want 42: %v", err)
	}
}
