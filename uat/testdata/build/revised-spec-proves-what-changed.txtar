# A revised spec proves what changed.
# x builds under verify-first, then y under build-and-verify.

# Given: a spec that waits for UAT, with its tests on main, and a revision on main that changes one Then.
# Test 1 says x.txt holds 42, and test 2 that x2.txt holds 7. The revision says x.txt holds 43.
exec kiln queue x
exec kiln fire
stdout '^x: landed on main'
exec kiln status
stdout '^x: waiting for UAT$'
exec git show main:acceptance/x/x_test.go
stdout 'func TestAT2'
exec sed -i '' 's/it holds 42\./it holds 43./' .kiln/specs/x.md
exec git commit --quiet -am 'docs(x): revise test 1'

# When: the developer queues it again, and kiln fire builds it.
exec kiln queue x
exec kiln fire

# Then: the proof gate fails on the changed test,
cp stdout .tmp/x-fire
exec jq -se --arg s x '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | any(.[]; .build==$b and .kind=="gate" and .proof==true and .passed!=true)' .git/kiln/ledger.jsonl
grep 'TestAT1' .claude-calls/audit/2/1/prompt
! grep 'TestAT2' .claude-calls/audit/2/1/prompt

# and the work lands.
grep '^x: landed on main' .tmp/x-fire
exec git show main:x.txt
stdout '^43$'
exec git show main:acceptance/x/x_test.go
stdout 'want 43'

# The same holds side by side.
exec sed -i '' 's/"verify-first"/"build-and-verify"/' .kiln/kiln.json
exec git commit --quiet -am 'chore: build side by side'
exec kiln queue y
exec kiln fire
stdout '^y: landed on main'
exec sed -i '' 's/it holds 42\./it holds 43./' .kiln/specs/y.md
exec git commit --quiet -am 'docs(y): revise test 1'
exec kiln queue y
exec kiln fire
cp stdout .tmp/y-fire
exec jq -se --arg s y '(map(select(.kind=="build" and .spec==$s)) | last | .build) as $b | any(.[]; .build==$b and .kind=="gate" and .proof==true and .passed!=true)' .git/kiln/ledger.jsonl
grep 'TestAT1' .claude-calls/audit/4/1/prompt
! grep 'TestAT2' .claude-calls/audit/4/1/prompt
grep '^y: landed on main' .tmp/y-fire
exec git show main:y.txt
stdout '^43$'
exec git show main:acceptance/y/y_test.go
stdout 'want 43'

-- .kiln/kiln.json --
{"workflow": "verify-first", "rounds": 3}
-- claude.json --
{
  "verify": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x42/.\" ."}}},
      {"result": {"result": "Wrote the tests of x."}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x43/.\" ."}}},
      {"result": {"result": "TestAT1 wants 43, as the revised spec says."}}
    ]},
    "3": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y42/.\" ."}}},
      {"result": {"result": "Wrote the tests of y."}}
    ]},
    "4": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y43/.\" ."}}},
      {"result": {"result": "TestAT1 wants 43, as the revised spec says."}}
    ]}
  },
  "build": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo 42 >x.txt && echo 7 >x2.txt"}}},
      {"result": {"result": "Built x."}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo 43 >x.txt"}}},
      {"result": {"result": "Built x again."}}
    ]},
    "3": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo 42 >y.txt && echo 7 >y2.txt"}}},
      {"result": {"result": "Built y."}}
    ]},
    "4": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "echo 43 >y.txt"}}},
      {"result": {"result": "Built y again."}}
    ]}
  },
  "audit": {
    "1": {"1": [{"result": {"audit": {"read": 1}}}]},
    "2": {"1": [{"result": {"audit": {"read": 1}}}]},
    "3": {"1": [{"result": {"audit": {"read": 1}}}]},
    "4": {"1": [{"result": {"audit": {"read": 1}}}]}
  }
}
-- doc.go --
// Package scratch is where kiln's builds land.
package scratch
-- .kiln/specs/x.md --
### 1. x.txt answers

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it holds 42.

### 2. x2.txt answers

- **Given**: nothing.
- **When**: the developer reads x2.txt.
- **Then**: it holds 7.
-- .kiln/specs/y.md --
### 1. y.txt answers

- **Given**: nothing.
- **When**: the developer reads y.txt.
- **Then**: it holds 42.

### 2. y2.txt answers

- **Given**: nothing.
- **When**: the developer reads y2.txt.
- **Then**: it holds 7.
-- _given/x42/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"testing"
)

func TestAT1(t *testing.T) {
	if b, _ := os.ReadFile("../../x.txt"); string(b) != "42\n" {
		t.Fatalf("x.txt holds %q, want 42", b)
	}
}

func TestAT2(t *testing.T) {
	if b, _ := os.ReadFile("../../x2.txt"); string(b) != "7\n" {
		t.Fatalf("x2.txt holds %q, want 7", b)
	}
}
-- _given/x43/acceptance/x/x_test.go --
