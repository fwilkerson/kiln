# The gate judges what lands: a repository the session makes inside its worktree lands as a pointer, without its
# files, and the gate runs without them too.

# Given: an approved spec. The build's session puts a test's fixture, acceptance/x/data/want.golden, in a git
# repository of its own, so the commit holds only a pointer to it. In its second round the session drops that
# repository's .git, and the fixture lands as a plain file.
exec kiln queue x

# When: the developer runs kiln fire.
exec kiln fire

# Then: the first gate fails, since the commit lacks the fixture, and the failure goes back to the session.
stdout '^x: the gate failed; it goes back to the session, round 1 of 2$'
grep 'open data/want.golden: no such file' .claude-calls/build/1/2/prompt

# Once the fixture is a plain file, the build lands, and its test passes on main.
stdout '^x: landed on main'
exec go test ./acceptance/x/
stdout '^ok'

-- .kiln/kiln.json --
{"rounds": 2}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers what data/want.golden holds.
-- claude.json --
{
  "build": {"1": {
    "1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" . && cd acceptance/x/data && git init -q && git add . && git -c user.name=s -c user.email=s@example.com commit -qm data"}}},
      {"result": {"result": "Built x."}}
    ],
    "2": [
      {"tool": {"name": "Bash", "input": {"command": "git rm -q --cached acceptance/x/data && rm -rf acceptance/x/data/.git && git add acceptance/x/data"}}},
      {"result": {"result": "Kept data/want.golden."}}
    ]
  }},
  "audit": {"1": {"1": [{"result": {"result": "read 1 directory, found 0"}}]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/acceptance/x/data/want.golden --
42
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"os"
	"strconv"
	"strings"
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	want, err := os.ReadFile("data/want.golden")
	if err != nil {
		t.Fatal(err)
	}

	if got := strconv.Itoa(scratch.X()); got != strings.TrimSpace(string(want)) {
		t.Fatalf("X answers %s, want %s", got, want)
	}
}
