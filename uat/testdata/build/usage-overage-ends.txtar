# A session that bills overage ends, and pauses as a limit does.

# Given: a build whose session reports overage, then works on.
exec kiln queue x

# When: the build runs.
exec kiln fire
stdout '^x: paused for a usage limit'

# Then: kiln ends the session at the overage, and reads nothing it did after,
! exists $WORK/ran-on
! exec sh -c 'grep -l overage-marker .git/kiln/sessions/*/stream.jsonl'

# and the same session resumes once the limit resets.
grep '"resume": true' .claude-calls/build/1/2/call.json
grep 'The usage limit has reset' .claude-calls/build/1/2/prompt
exec kiln status
stdout '^x: waiting for UAT$'

-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {
    "1": [
      {"limit": {"status": "allowed", "using_overage": true, "resets_in": "1s"}},
      {"tool": {"name": "Bash", "input": {"command": "echo overage-marker; sleep 2; touch \"$WORK/ran-on\""}}},
      {"result": {"result": "Worked on at overage."}}
    ],
    "2": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
      {"result": {"result": "Built x."}}
    ]
  }},
  "audit": {"1": {"1": [{"result": {"result": "read 2 packages, found 0"}}]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
