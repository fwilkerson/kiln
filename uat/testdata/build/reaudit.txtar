# A change to a path the audit must read goes back to the audit.

# Given: kiln.json names a path the audit must read whenever the work changes it, and the audit finds a problem whose
# fix changes that path.
exec kiln queue x

# When: kiln fire builds the spec, and the build session fixes the finding.
exec kiln fire
stdout '^x: landed on main'
grep 'harness/h\.go:5  weak test' .claude-calls/build/1/2/prompt

# Then: the audit reads the work again before it lands.
exists .claude-calls/audit/2/1/call.json
grep 'harness/h\.go' .claude-calls/audit/2/1/prompt
grep '"role":"audit"[^\n]*\n(?:[^\n]*\n)*?[^\n]*"role":"audit"[^\n]*\n(?:[^\n]*\n)*?[^\n]*"outcome":"landed"' .git/kiln/ledger.jsonl
exec git show main:harness/h.go
stdout 'Checked = true'

-- .kiln/kiln.json --
{"workflow": "build-and-verify", "rounds": 3, "testHelpers": ["harness/"], "reaudit": ["harness/"]}
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/code/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Built x."
     }
    }
   ],
   "2": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/fixed/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Fixed the harness."
     }
    }
   ]
  }
 },
 "verify": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "cp -R \"$WORK/_given/tests/.\" ."
      }
     }
    },
    {
     "result": {
      "result": "Wrote the tests of x."
     }
    }
   ],
   "2": [
    {
     "result": {
      "result": "My tests hold."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "audit": {"read": 3, "findings": [{"path": "harness/h.go", "line": 5, "kind": "weak test", "harm": "it checks nothing"}]}
     }
    }
   ]
  },
  "2": {
   "1": [
    {
     "result": {
      "audit": {"read": 3}
     }
    }
   ]
  }
 }
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/code/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/code/harness/h.go --
// Package harness is what the acceptance tests run through.
package harness

// Checked is false.
const Checked = false
-- _given/fixed/harness/h.go --
// Package harness is what the acceptance tests run through.
package harness

// Checked is true.
const Checked = true
-- _given/tests/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
