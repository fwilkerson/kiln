	if !strings.Contains(string(code), "return 43") {
		t.Fatalf("x.go does not answer 43, want 43: %v", err)
	}
}

func TestAT2(t *testing.T) {
	code, err := os.ReadFile("../../x.go")
	if !strings.Contains(string(code), "return 7") {
		t.Fatalf("x.go does not answer 7, want 7: %v", err)
	}
}
-- _given/tests43/integration/x/x_test.go --
