# A running first run: one mark for what kiln does not know, and its calls newest first.

# Given: a build whose session has made several calls and is inside another, so kiln does not yet know its cost, its
# turns or its time.
# Its run makes two calls, then runs a command that waits for go-on, and touches waiting first, so the script knows
# it is inside the call. Until its result event, its cost and turns are unknown, and so are the build's cost, turns
# and time.
exec kiln queue x
exec kiln fire &
exec await waiting

# When: the developer opens kiln tui,
term 120 30 kiln tui
screen '▶ x · build role · first run · running'

# Then: each number kiln does not know shows as ?, and no screen shows the word "unknown".
screen '\w{3} \d\d \d\d:\d\d x +▶ running +1 test +\d+[sm] +\? +\? +\? +0 +│$'
! screen 'unknown'

# When: the spec's builds,
keys j
screen 'builds of x · approved once'

# Then:
screen ' #1 +▶ running +1 test +\d+[sm] +\? +\? +\? +0 +│$'
! screen 'unknown'

# When: the build,
keys enter
screen '^x · build 1 · '

# Then:
screen '^time \?: .* · cost \? · \? turns · \? failed, \? refused$'
screen '^1 +build +first run +▶ \S+ +\? +\? +\? '
! screen 'unknown'

# When: and the running run.
keys enter
screen '^x · build 1 · run 1: first run · build role · session '

# Then:
screen '^▶ running .* · turns \? · cost \?$'
! screen 'unknown'

# The calls are listed newest first,
screen '\n\n▶ \d\d:\d\d:\d\d Bash +touch .* running\n  \d\d:\d\d:\d\d Bash +echo the second call .*\n  \d\d:\d\d:\d\d Bash +echo the first call '
! screen 'echo the next call'

# When: and the session makes another call.
exec touch go-on

# Then: and the new call appears at the top with no key pressed.
screen '\n\n▶ \d\d:\d\d:\d\d Bash +echo the next call .* running\n  \d\d:\d\d:\d\d Bash +touch .*\n  \d\d:\d\d:\d\d Bash +echo the second call '
exec touch done
wait
stdout '^x: landed on main'

-- .kiln/kiln.json --
{"rounds": 0}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {
    "1": [
      {"tool": {"name": "Bash", "input": {"command": "echo the first call"}}},
      {"tool": {"name": "Bash", "input": {"command": "echo the second call"}}},
      {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/waiting\" && await \"$WORK/go-on\""}}},
      {"tool": {"name": "Bash", "input": {"command": "echo the next call && cp -R \"$WORK/_given/right/.\" . && await \"$WORK/done\""}}},
      {"result": {"result": "Built x.", "cost_usd": 0.50}}
    ]
  }},
  "audit": {"1": {"1": [{"result": {"audit": {"read": 1}}}]}}
}
-- _given/right/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/right/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
