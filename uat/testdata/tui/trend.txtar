# 5. The trend on the home screen.

# Given: more builds than the home screen's recent window holds.
# Spec t is built 12 times, each from a revision of its spec. Its first 2 builds each fail the gate once, fail a
# call, and cost $5.00. The last 10 each pass at once, fail no call, and cost $1.00.
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 2." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 3." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 4." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 5." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 6." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 7." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 8." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 9." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 10." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 11." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'
exec sh -c 'echo "Revision 12." >>.kiln/specs/t.md && git commit --quiet -am "docs(t): revise"'
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'

# When: the developer opens kiln tui.
term 120 30 kiln tui

# Then: it shows cost, minutes, failed calls and rounds per build, and size, each for the recent builds beside the
# builds before them.
# Each number is a tile: its name, the median of the last 10 builds, then the median of the 2 before them.
screen 'last 10 builds · median of each, and how it moved from the 2 before'
screen 'cost +minutes +failed calls +rounds +size, tests +│$'
screen '│\$1\.00 ▼ was \$5\.00 +[0-9.]+ (?:[▲▼] was [0-9.]+|same) +0 ▼ was 1 +0 ▼ was 1 +1 same +│$'

-- .kiln/kiln.json --
{"gate": ["test -e ready"]}
-- .kiln/specs/t.md --
### 1. T is ready

- **Given**: nothing.
- **When**: the gate runs.
- **Then**: ready is there.
