# 4. The spec as its build saw it.

# Given: a spec the developer accepted, which main no longer holds, and another spec waiting on its branch with an
# amendment.
# Both specs are longer than the terminal is tall, so their ends show only once scrolled to. Once a is approved, the
# developer edits it on main, so only the text it was approved at lacks the edit.
exec kiln queue a
exec sh -c 'echo "This line came after the approval." >>.kiln/specs/a.md && git commit --quiet -am "docs(a): edit"'
exec kiln queue b
exec kiln fire
stdout '^a: landed on main'
stdout '^b: waits on kiln/b'
exec kiln accept a
stdout '^a: accepted'
! exec git cat-file -e main:.kiln/specs/a.md

# When: the developer opens each one's spec text, and scrolls to its end.
term 120 24 kiln tui a
screen 'builds of a · approved once'
keys s
screen '^a · as approved at [0-9a-f]{12}$'

# Then: the first shows the text it was approved at.
screen 'Spec 1: a'
screen 'This line opens spec a\.'
! screen 'This line ends spec a\.'
keys end
screen 'This line ends spec a\.'
! screen 'came after the approval'

# The second shows its text and its amendment.
keys esc / b enter
screen 'builds of b · approved once'
keys s
screen '^b · as approved at [0-9a-f]{12}, with its amendments$'
screen 'This line opens spec b\.'
! screen 'b answers 3'
keys end
screen 'b answers 3'
screen 'This line ends the amendment of spec b\.'

-- .kiln/specs/a.md --
