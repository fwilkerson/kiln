{
  "build": {
    "1": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
      {"result": {"result": "Built x, under an amendment."}}
    ]},
    "2": {"1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/y/.\" ."}}},
      {"result": {"result": "Built y, under an amendment."}}
    ]}
  },
  "audit": {"1": {"1": [{"result": {"result": "read 2 packages, found 0, reported 0"}}]}, "2": {"1": [{"result": {"result": "read 2 packages, found 0, reported 0"}}]}}
}
