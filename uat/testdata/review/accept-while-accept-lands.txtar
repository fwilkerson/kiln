# A spec accepted while another kiln accept lands, which lands it too, as the reply says.

# Given: two specs waiting on their branches with amendments. Once $HOME/.hold exists, the gate waits for
# $HOME/.go.
exec kiln queue x
exec kiln queue y
exec kiln fire
stdout '^x: waits on kiln/x'
stdout '^y: waits on kiln/y'

# When: the developer accepts x, and accepts y while x's landing holds the specs' lane,
exec sh -c 'touch "$HOME/.hold"; kiln accept x >"$HOME/x.out" 2>&1 & await "$HOME/.gating"; kiln accept y; s=$?; touch "$HOME/.go"; wait $!; exit $s'

# Then: the reply names the kiln accept that is landing, and no kiln fire, since none runs.
stdout '^y: accepted; the kiln accept that is landing lands it$'
! stdout 'kiln fire'

# The kiln accept of x lands both, so no spec is left.
exec kiln status
stdout '^kiln holds no approved spec$'

-- .kiln/kiln.json --
{"gate": ["sh -c 'if [ -f \"$HOME/.hold\" ]; then touch \"$HOME/.gating\"; await \"$HOME/.go\"; fi'"]}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- .kiln/specs/y.md --
### 1. Y answers

- **Given**: nothing.
- **When**: Y is called.
- **Then**: it answers 42.
