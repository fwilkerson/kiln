# An accepted spec is retired, though Ctrl-C cut kiln accept short as it removed the worktree.

# Given: a spec waiting for UAT. A git first on the PATH interrupts kiln, as Ctrl-C does, at the first worktree removal
# after a fast-forward merge moves main, and runs it only once kiln has seen the interrupt.
exec kiln queue x
exec kiln fire
exec kiln status
stdout '^x: waiting for UAT$'
exec sh -c 'printf "#!/bin/sh\ncase \" \$* \" in *\" worktree remove \"*) [ -e \"$WORK/.tmp/merged\" ] && [ ! -e \"$WORK/.tmp/killed\" ] && { touch \"$WORK/.tmp/killed\"; kill -INT \$PPID; await \"$WORK/.tmp/never\" </dev/null >/dev/null 2>&1; } ;; esac\n\"%s\" \"\$@\" || exit\ncase \" \$* \" in *\" merge \"*\" --ff-only \"*) touch \"$WORK/.tmp/merged\" ;; esac\n" "$(command -v git)" >.tmp/git && chmod +x .tmp/git'

# When: kiln accept is interrupted once main holds the retired spec, and the developer runs kiln accept again.
exec exits 1 sh -c 'PATH="$PWD/.tmp:$PATH" exec kiln accept x'
exists .tmp/killed
exec git log -1 --format=%s main
stdout '^docs\(x\): retire the accepted spec$'
exec kiln accept x
stdout '^x: accepted'

# Then: kiln status no longer lists the spec, main retires it once, and kiln dropped the branch and its worktree.
exec kiln status
! stdout '^x:'
exec git log --format=%s main
stdout -count=1 '^docs\(x\): retire the accepted spec$'
! exec git rev-parse --verify --quiet kiln/x
exec git worktree list
! stdout 'kiln/x'

-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
    {"result": {"result": "Built x."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"result": "read 1 directory, found 0"}}]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
