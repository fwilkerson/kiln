# An accepted landing that stops says so, and can land again.

# Given: a spec waiting on its branch, whose landing stops once accepted.
# Main's checkout holds an uncommitted PRODUCT.md, which the landing writes, so main can't move to it.
exec kiln queue x
exec kiln run
stdout '^x: waits on kiln/x'
cp _given/PRODUCT.md PRODUCT.md
! exec kiln accept x
cp stdout .tmp/accept
stdout '^x: stopped: '
stderr '^kiln accept: the landing of x stopped'

# kiln accept's output holds one notification, which names the spec and the state kiln status shows for it, stopped,
# landing accepted amendments.
stdout -count=1 '\x1b\]9;'
stdout '^\x1b\]9;kiln: x stopped, landing accepted amendments\x07'

# After the line that says the build stopped, the output names kiln accept and kiln reject as what to run next, and
# doesn't name kiln queue.
exec cat .tmp/accept
stdout '(?s)^x: stopped: .*^  next: .*kiln accept x\b.*kiln reject x\b'
! stdout 'kiln queue'
exec git log --format=%H main -- x.go
! stdout .

# When: the developer runs kiln queue on it,
! exec kiln queue x

# Then: the queue is refused, and kiln status shows the spec stopped, landing accepted amendments.
stderr '^kiln queue: refused: '
exec kiln status
stdout '^x: stopped, landing accepted amendments$'

# When: then fixes what stopped the landing and runs kiln accept again.
exec git add PRODUCT.md
exec git commit --quiet -m 'docs: start the product'
exec kiln accept x
stdout '^x: accepted, and main is at '

# Then: after the second accept, main holds the spec's work,
exec git diff --quiet main
exists x.go acceptance/x/x_test.go
exec go test ./acceptance/x/
stdout '^ok'

# the spec as accepted, amendments folded in, is retired,
! exists .kiln/specs/x.md .kiln/specs/x.amend.md
exec sh -c '$(sed -n "s/^- Spec 1: x: .\(git show .*\).$/\1/p" PRODUCT.md)'
stdout '^- \*\*Then\*\*: it answers 43.$'
! stdout 'answers 42'
exec kiln status
stdout '^kiln holds no approved spec$'

# and PRODUCT.md names it, once.
grep '^The developer''s own product page.$' PRODUCT.md
grep '^- Spec 1: x: `git show [0-9a-f]{12}:.kiln/specs/x.md`$' PRODUCT.md
exec grep -c '.kiln/specs/x.md' PRODUCT.md
stdout '^1$'

-- _given/PRODUCT.md --
# Product

The developer's own product page.

-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
    {"result": {"result": "Built x, under an amendment."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"result": "read 2 packages, found 0"}}]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 43.
func X() int { return 43 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 43 {
		t.Fatalf("X answers %d, want 43", got)
	}
}
-- _given/x/.kiln/specs/x.amend.md --
# Amendments to .kiln/specs/x.md

## Acceptance test 1: X answers

### Old

- **Then**: it answers 42.

### New

- **Then**: it answers 43.

### Reason

42 is taken.
