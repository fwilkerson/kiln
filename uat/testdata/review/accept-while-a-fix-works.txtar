# A spec's amendments land while a monitor's fix is at work.

# Given: a spec waiting on its branch with amendments.
exec kiln queue x
exec kiln fire
stdout '^x: waits on kiln/x'

# kiln monitor run is at work on a fix. Its session touches .tmp/fixing, then waits for .tmp/fix-go.
exec kiln monitor run &mon&
exec sh -c 'i=0; while [ ! -e .tmp/fixing ] && [ $i -lt 1200 ]; do sleep 0.1; i=$((i+1)); done; [ -e .tmp/fixing ]'

# When: the developer runs kiln accept with the spec's name.
exec kiln accept x
stdout '^x: accepted, and main is at '

# Then: the spec lands on main,
exec git show main:x.txt
stdout '^x$'

# and is retired,
! exec git cat-file -e main:.kiln/specs/x.md
! exec git cat-file -e main:.kiln/specs/x.amend.md
exec kiln status
! stdout '^x:'

# while the fix's session is still at work.
! exists .tmp/fix-go
stdout '^notes: fix building, '

# The fix's kiln ends once its session does.
exec touch .tmp/fix-go
wait mon

-- .kiln/kiln.json --
{"gate": ["true"], "monitors": [
 {"name": "notes", "every": "24h", "check": "sh .kiln/monitors/notes", "agent": ".kiln/agents/notes.md", "prompt": "Write the note."}
]}
-- .kiln/monitors/notes --
if [ -e note.txt ]; then
  echo '{"fix": false, "summary": "note.txt is there"}'
else
  echo '{"fix": true, "summary": "note.txt is missing"}'
fi
-- .kiln/agents/notes.md --
Write the missing note.
-- .kiln/specs/x.md --
### 1. X is there

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it says x.
-- _given/x/x.txt --
x
-- _given/x/.kiln/specs/x.amend.md --
# Amendments to .kiln/specs/x.md

## Acceptance test 1: X is there

### Old

- **Then**: it says x.

### New

- **Then**: it says x, on one line.

### Reason

x.txt holds one line.
-- claude.json --
{
 "notes": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/.tmp/fixing\"; i=0; while [ ! -e \"$WORK/.tmp/fix-go\" ] && [ $i -lt 3000 ]; do sleep 0.1; i=$((i+1)); done; echo noted >note.txt"}}},
  {"result": {"result": "Wrote note.txt.\n{\"title\": \"fix(notes): write the missing note\"}"}}
 ]}},
 "build": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
  {"result": {"result": "Built x, under an amendment."}}
 ]}},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "2": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
 }
}
