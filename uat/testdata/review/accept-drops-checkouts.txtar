# Accepting a landed spec leaves none of its build's checkouts, though accept ran the gate again on main.

# Given: a spec waiting for UAT.
exec kiln queue x
exec kiln fire
exec kiln status
stdout '^x: waiting for UAT$'

# When: the developer runs kiln accept.
exec kiln accept x
stdout '^x: accepted'

# Then: no worktree of x's build is left.
exec git worktree list
! stdout '/(\.gate-|\.audit-)?x '

-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
    {"result": {"result": "Built x."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"result": "read 1 directory, found 0"}}]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
