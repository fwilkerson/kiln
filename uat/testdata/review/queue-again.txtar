-- _given/first/first.go --
// Package scratch is where kiln's builds land.
package scratch

// First answers 1.
func First() int { return 1 }
-- _given/first/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.First(); got != 1 {
		t.Fatalf("First answers %d, want 1", got)
	}
}
-- _given/second/second.go --
