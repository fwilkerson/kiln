# An accepted landing keeps the spec as the developer accepted it.

# Given: a spec waiting on its branch with an amendment, and main changed x.txt, as the work did.
exec kiln queue x
exec kiln fire
stdout '^x: waits on kiln/x, with amendments for UAT'
exec sh -c 'echo main >x.txt && git add x.txt && git commit --quiet -m main'

# When: the developer accepts it. The conflict goes back to the session, which merges main, rewrites the folded
# spec, and writes an amendment file again, by a shell command.
exec kiln accept x
stdout '^x: accepted, and main is at '
grep 'conflicts with it in these files:\nx.txt' .claude-calls/build/1/2/prompt

# Then: the gate refuses the session's change to the spec and to its amendment file, and the session takes it out.
grep '\.kiln/specs/x\.md' .claude-calls/build/1/3/prompt
grep '\.kiln/specs/x\.amend\.md' .claude-calls/build/1/3/prompt

# The spec PRODUCT.md shows holds the wording the developer accepted.
! exists .kiln/specs/x.md .kiln/specs/x.amend.md
exec sh -c '$(sed -n "s/^- Spec 1: x: .\(git show .*\).$/\1/p" PRODUCT.md)'
stdout '^- \*\*Then\*\*: it answers 42, or more\.$'
! stdout '41'

-- .kiln/kiln.json --
{"rounds": 3}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- claude.json --
{
  "build": {"1": {
    "1": [
      {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
      {"result": {"result": "Built x, under an amendment."}}
    ],
    "2": [
      {"tool": {"name": "Bash", "input": {"command": "git merge --quiet --no-edit -X theirs main && sed -i '' 's/42, or more/41, or more/' .kiln/specs/x.md && cp \"$WORK/_given/x/.kiln/specs/x.amend.md\" .kiln/specs/"}}},
      {"result": {"result": "Merged main, and reworded the spec."}}
    ],
    "3": [
      {"tool": {"name": "Bash", "input": {"command": "sed -i '' 's/41, or more/42, or more/' .kiln/specs/x.md && rm .kiln/specs/x.amend.md"}}},
      {"result": {"result": "Put the spec back as accepted."}}
    ]
  }},
  "audit": {"1": {"1": [{"result": {"audit": {"read": 2}}}]}}
}
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/x.txt --
the work
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
-- _given/x/.kiln/specs/x.amend.md --
# Amendments to .kiln/specs/x.md

## Acceptance test 1: X answers

### Old

- **Then**: it answers 42.

### New

- **Then**: it answers 42, or more.

### Reason

A larger answer serves too.
