# An accepted fix that conflicts with main lands, once the session that made it merges main. kiln status shows the
# session at work, the audit reads what the session changed, and the landing's commit names it.

# Given: a monitor whose fixes wait for kiln accept, and a fix its agent made, waiting on its branch. The fix
# changed two files, doc.txt and extra.txt.
exec sh -c 'kiln monitor run || true'
exec kiln status
stdout 'stale.*waiting'

# Main changed doc.txt since, in a line the fix changed.
exec sh -c 'printf "title\nstale, by hand\n" >doc.txt && git commit -qam "docs: edit by hand"'
exec git rev-parse main
cp stdout .tmp/main-before

# When: the developer runs kiln accept with the monitor's name, and kiln status runs while the fix's session merges
# main. The session waits for .tmp/go-on before it merges.
exec kiln accept stale &
exec await .tmp/merging
exec kiln status

# Then: kiln status shows the monitor's fix landing, and that its session is at work on a conflict with main.
stdout 'stale: accepted, landing: conflict with main, round 1 of 3'

exec touch .tmp/go-on
wait

# kiln resumes the session that made the fix, and tells it each file in conflict.
! exists .claude-calls/fix/2
grep '"resume": ?true' .claude-calls/fix/1/2/call.json
grep 'doc\.txt' .claude-calls/fix/1/2/prompt
grep 'git merge main' .claude-calls/fix/1/2/prompt

# Once the gate passes, and before main moves, the audit runs, and kiln tells it the file the session changed. It
# leaves out extra.txt, which the fix changed before kiln accept.
grep 'doc\.txt' .claude-calls/audit/2/1/prompt
! grep 'extra\.txt' .claude-calls/audit/2/1/prompt

# The audit's findings go back to the fix's session. When the session answers them, main has not moved yet.
grep 'doc\.txt:2 drops the title' .claude-calls/fix/1/3/prompt
cmp .tmp/main-at-answer .tmp/main-before

# Main holds both main's change and the fix's, in each file the fix changed.
exec git show main:doc.txt
stdout 'by hand'
stdout 'fixed'
exec git show main:extra.txt
stdout '^extra, fixed$'

# The commit that moved main names the file the session changed, and not the file that lands as the developer
# accepted it.
exec git log -1 --format=%b main
stdout '^Changed since kiln accept: doc\.txt$'

-- .kiln/kiln.json --
{"gate": ["true"], "rounds": 3}
-- .kiln/monitors/stale/check --
if grep -q fixed doc.txt; then
  echo '{"fix": false, "summary": "doc.txt is fixed"}'
else
  echo '{"fix": true, "summary": "doc.txt is stale"}'
fi
-- .kiln/monitors/stale/agent.md --
Mark the doc fixed.

Mark the doc fixed.
-- .kiln/monitors/stale/monitor.json --
{"mustAccept": true}
-- doc.txt --
title
stale
-- extra.txt --
extra
-- claude.json --
{
 "fix": {"1": {
  "1": [
   {"tool": {"name": "Bash", "input": {"command": "printf 'title\\nfixed\\n' >doc.txt && echo 'extra, fixed' >extra.txt"}}},
   {"result": {"result": "Marked the doc fixed.\n{\"title\": \"fix(doc): mark the doc fixed\"}"}}
  ],
  "2": [
   {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/.tmp/merging\"; await \"$WORK/.tmp/go-on\"; git merge main; printf 'title\\nfixed, by hand\\n' >doc.txt && git add doc.txt && git commit -q --no-edit"}}},
   {"result": {"result": "Merged main, keeping both lines' changes."}}
  ],
  "3": [
   {"tool": {"name": "Bash", "input": {"command": "git rev-parse main >\"$WORK/.tmp/main-at-answer\""}}},
   {"result": {"result": "The title is still on line 1, so the finding is wrong."}}
  ]
 }},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0, reported 0"}}]},
  "2": {"1": [{"result": {"result": "1. doc.txt:2 drops the title\n\nread 1 directories, found 1, reported 1"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0, reported 0"}}]}
 }
}
