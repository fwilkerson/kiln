# A fix writes the tests only when its monitor says it may, under any acceptance path.

env KILN_OPEN=true

# Given: kiln.json names two acceptance paths, uat/{spec}/ and integration/{spec}/. A monitor that doesn't say its
# fixes may write the tests changes a file under the second path. A second monitor that says they may changes a
# file under the first.

# When: the developer runs kiln monitor run.
exec sh -c 'kiln monitor run || true'

# Then: the first monitor's fix stops
exec kiln status
stdout 'guarded.*stopped'

# and its change is not on main,
exec git show main:integration/a/note.txt
! stdout 'changed by guarded'

# and main holds the second monitor's change.
exec git show main:uat/b/note.txt
stdout '^changed by trusted$'

-- .kiln/kiln.json --
{"gate": ["true"], "acceptance": ["uat/{spec}/", "integration/{spec}/"]}
-- .kiln/monitors/guarded/command --
echo 'changed by guarded' >>integration/a/note.txt
-- .kiln/monitors/guarded/monitor.json --
{"hours": 168}
-- .kiln/monitors/trusted/command --
echo 'changed by trusted' >>uat/b/note.txt
-- .kiln/monitors/trusted/monitor.json --
{"hours": 168, "tests": true}
-- integration/a/note.txt --
a's tests
-- uat/b/note.txt --
b's tests
