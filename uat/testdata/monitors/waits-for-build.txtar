# A monitor runs beside a running build: the specs' lane and the monitors' lane each hold one kiln.

# Given: a monitor that is due, while kiln fire builds a spec.
# The build's session touches waiting, then waits for done, so the script knows the build is running.
exec kiln queue x
exec kiln fire &
exec await waiting

# When: the developer runs kiln monitor run,
exec sh -c 'kiln monitor run || true'

# Then: the run runs the monitor's check, while the build still runs.
grep -count=1 'ran' $WORK/_given/check.log

# When: the build ends, and the developer runs kiln monitor run again,
exec touch done
wait
exec kiln monitor run

# Then: the monitor is not due, so its check ran once in all.
grep -count=1 'ran' $WORK/_given/check.log

-- .kiln/kiln.json --
{"gate": ["test -e ready"]}
-- .kiln/monitors/deps/check --
echo ran >>"$WORK/_given/check.log"
echo '{"fix": false, "summary": "every module is current"}'
-- .kiln/monitors/deps/command --
true
-- _given/check.log --
-- .kiln/specs/x.md --
### 1. X is ready

- **Given**: nothing.
- **When**: the gate runs.
- **Then**: ready is there.
-- claude.json --
{
 "build": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/waiting\" && await \"$WORK/done\" && touch ready"}}},
  {"result": {"result": "Built it."}}
 ]}},
 "audit": {"1": {"1": [
  {"result": {"result": "read 1 directories, found 0"}}
 ]}}
}
