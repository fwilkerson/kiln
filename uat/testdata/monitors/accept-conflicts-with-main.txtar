# An accepted fix whose landing meets a conflict with main names kiln reject, since no session resolves it.

env KILN_OPEN=true

# Given: a monitor whose fixes wait for kiln accept, a fix of it waiting on its branch, and main changed since in
# the lines the fix changed.
exec sh -c 'kiln monitor run || true'
exec kiln status
stdout 'docs.*waiting'
exec sh -c 'echo "the docs, written by hand" >docs.txt && git add docs.txt && git commit -qm "docs: write by hand"'

# When: the developer runs kiln accept with the monitor's name.
! exec kiln accept docs

# Then: its summary says main changed what the fix changed. Its output and kiln status name kiln reject docs, and
# never ask to accept again.
stdout 'docs: stopped: main changed what the fix changed'
stdout 'kiln reject docs'
! stdout 'kiln accept docs to land it again'
stderr 'kiln reject docs'
! stderr 'kiln accept docs lands it again'
exec kiln status
stdout 'main changed what the fix changed'
stdout 'kiln reject docs'
! stdout 'kiln accept docs to land it again'
! stdout 'git merge main'

-- .kiln/kiln.json --
{"gate": ["true"], "monitors": [
 {"name": "docs", "every": "168h", "command": "echo 'the docs, brought up to date' >docs.txt", "accept": true}
]}
