# An accepted fix lands while a spec builds.

# Given: a monitor's fix waiting on its branch for kiln accept.
exec sh -c 'kiln monitor run || true'
exec kiln status
stdout '^notes: waiting on the developer'

# kiln fire is at work on a spec. Its build session touches .tmp/building, then waits for .tmp/build-go.
exec kiln queue x
exec kiln fire &fire&
exec await .tmp/building

# When: the developer runs kiln accept with the monitor's name.
exec kiln accept notes

# Then: the fix lands on main
exec git show main:note.txt
stdout '^noted$'

# while the build session is still at work.
! exists .tmp/build-go
exec kiln status
stdout '^x: building'

# The build's kiln ends once its session does.
exec touch .tmp/build-go
wait fire

-- .kiln/kiln.json --
{"gate": ["true"]}
-- .kiln/monitors/notes/check --
if [ -e note.txt ]; then
  echo '{"fix": false, "summary": "note.txt is there"}'
else
  echo '{"fix": true, "summary": "note.txt is missing"}'
fi
-- .kiln/monitors/notes/agent.md --
Write the missing note.

Write the note.
-- .kiln/monitors/notes/monitor.json --
{"mustAccept": true}
-- .kiln/specs/x.md --
### 1. X is there

- **Given**: nothing.
- **When**: the developer reads x.txt.
- **Then**: it says x.
-- _given/x/x.txt --
x
-- claude.json --
{
 "fix": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "echo noted >note.txt"}}},
  {"result": {"result": "Wrote note.txt.\n{\"title\": \"fix(notes): write the missing note\"}"}}
 ]}},
 "build": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/.tmp/building\"; await \"$WORK/.tmp/build-go\"; cp -R \"$WORK/_given/x/.\" ."}}},
  {"result": {"result": "Built x."}}
 ]}},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0, reported 0"}}]},
  "2": {"1": [{"result": {"result": "read 1 directories, found 0, reported 0"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0, reported 0"}}]}
 }
}
