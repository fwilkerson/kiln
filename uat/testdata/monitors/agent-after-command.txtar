# The agent fixes what the command left failing.

# Given: a monitor whose check prints a finding above its last line, whose command leaves a gate command failing, and
# whose agent makes it pass.

# When: the developer runs kiln monitor run.
exec kiln monitor run

# Then: the agent's session was told the finding and what the gate printed,
grep 'finding: deps\.txt is missing' .claude-calls/fix/1/1/prompt
grep 'the gate: deps\.txt needs fix\.txt' .claude-calls/fix/1/1/prompt

# and main holds the command's work and the agent's.
exec git show main:deps.txt
stdout '^bumped$'
exec git show main:fix.txt
stdout '^fixed$'

-- .kiln/kiln.json --
{"gate": ["sh .kiln/gate"]}
-- .kiln/monitors/deps/check --
if [ -e deps.txt ]; then
  echo '{"fix": false, "summary": "deps.txt is there"}'
else
  echo 'finding: deps.txt is missing'
  echo '{"fix": true, "summary": "deps.txt is missing"}'
fi
-- .kiln/monitors/deps/command --
echo bumped >deps.txt
-- .kiln/monitors/deps/agent.md --
Fix what the bump broke.

Make the gate pass.
-- .kiln/gate --
if [ -e deps.txt ] && [ ! -e fix.txt ]; then
  echo 'the gate: deps.txt needs fix.txt'
  exit 1
fi
-- claude.json --
{
 "fix": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "echo fixed >fix.txt"
      }
     }
    },
    {
     "result": {
      "result": "Wrote fix.txt."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "audit": {"read": 1}
     }
    }
   ]
  }
 }
}
