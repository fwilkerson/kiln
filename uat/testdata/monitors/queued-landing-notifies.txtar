# A fix accepted while another kiln holds the monitors' lane shows as accepted. Its landing, which the next kiln monitor
# run takes up as it starts, notifies, as the fix's own run did.

# Given: a monitor whose fix waits for kiln accept, which handed its notice to kiln.json's notify, and printed no OSC 9,
exec sh -c 'kiln monitor run || true'
! stdout '\x1b\]9;'
grep -count=1 '^\{"kind":"monitor","name":"docs","state":"waiting on the developer",.*"next":"read it with git diff main\.\.\.kiln/docs, then run kiln accept docs' .git/notices
exec kiln status
stdout 'docs: waiting on the developer'

# and a kiln accept made while another kiln holds the monitors' lane. kiln status then shows the fix accepted, its
# landing waiting for the next kiln monitor run, though the ledger still says the fix waits.
exec sh -c 'perl -e ''use Fcntl qw(:flock); open(F, ">>", ".git/kiln/monitors.lock") or die; flock(F, LOCK_EX) or die; open(M, ">", ".git/locked"); close(M); system("await", ".git/release")'' & await .git/locked; kiln accept docs; s=$?; touch .git/release; wait $!; exit $s'
stdout 'docs: accepted; the next kiln monitor run lands it'
exec kiln status
! stdout 'waiting on the developer'
stdout 'docs: accepted, lands at the next kiln monitor run'

# and a commit on main that breaks the gate.
exec sh -c 'touch broken && git add broken && git commit -qm "break the gate"'

# When: the developer's next kiln monitor run starts,
exec sh -c 'kiln monitor run || true'

# Then: it stops the landing, and notifies a second time, with the state kiln status shows.
exec kiln status
stdout 'docs.*stopped'
grep -count=2 '"kind":"monitor"' .git/notices
grep -count=1 '"name":"docs","state":"stopped"' .git/notices

-- .kiln/kiln.json --
{"gate": ["test ! -f broken"], "notify": "printf '%s\\n' \"$KILN_NOTICE\" >>.git/notices"}
-- .kiln/monitors/docs/command --
echo 'the docs, brought up to date' >docs.txt
-- .kiln/monitors/docs/monitor.json --
{"hours": 168, "mustAccept": true}
