# kiln shows what a check found.

# Given: a monitor whose check prints that nothing needs a fix, with a summary; and a second monitor whose check
# prints a line and exits non-zero.
exec git rev-parse main
cp stdout $WORK/_given/main-before

# When: the developer runs kiln monitor run.
exec sh -c 'kiln monitor run || true'

# Then: main is unchanged,
exec git rev-parse main
cmp stdout $WORK/_given/main-before

# and kiln status shows the first monitor healthy, with its summary, and the second monitor couldn't run, with that
# line.
exec kiln status
stdout 'tidy.*healthy'
stdout 'every module is current'
stdout 'net.*couldn''t run'
stdout 'the network is down'

-- .kiln/kiln.json --
{"gate": ["true"]}
-- .kiln/monitors/tidy/check --
echo '{"fix": false, "summary": "every module is current"}'
-- .kiln/monitors/tidy/command --
true
-- .kiln/monitors/net/check --
echo 'the network is down'
exit 3
-- .kiln/monitors/net/command --
true
-- _given/main-before --
