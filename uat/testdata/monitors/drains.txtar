# A monitor that drains a queue in one run.

env KILN_OPEN=true

# Given: a monitor that drains. Its check asks for a fix while queue/ holds a file, and to drain the queue, and its
# command removes the first.

# When: the developer runs kiln monitor run, once.
exec kiln monitor run

# Then: two fixes landed, one for each file,
exec git log --format=%s main
stdout -count=2 '^fix\(queue\): '
exec git ls-tree -r --name-only main
! stdout '^queue/'

# and the run's last check found the queue empty.
exec kiln status
stdout '^queue: healthy'
stdout 'queue/ is empty'

-- .kiln/kiln.json --
{"gate": ["true"]}
-- .kiln/monitors/queue/check --
n=$(ls queue 2>/dev/null | wc -l | tr -d ' ')
if [ "$n" -eq 0 ]; then
  echo '{"fix": false, "summary": "queue/ is empty"}'
  exit 0
fi
echo "{\"fix\": true, \"summary\": \"$n in queue/\", \"drain\": true}"
-- .kiln/monitors/queue/command --
rm "$(ls queue/* | head -n 1)"
-- .kiln/monitors/queue/monitor.json --
{"every": "1h", "gates": false}
-- queue/a --
a
-- queue/b --
b
