# A command's fix lands.

env KILN_OPEN=true

# Given: a monitor whose check joins the gate, and asks for a fix until a file holds a line, and whose command writes
# that line.

# When: the developer runs kiln monitor run.
exec kiln monitor run

# Then: main holds the line,
exec git show main:state.txt
stdout '^current$'

# and kiln status shows the monitor's fix landed.
exec kiln status
stdout 'bump.*landed'

-- .kiln/kiln.json --
{"gate": ["true"], "monitors": [
 {"name": "bump", "every": "24h", "check": "sh .kiln/monitors/bump", "gates": true, "command": "echo current >>state.txt"}
]}
-- .kiln/monitors/bump --
if grep -qx current state.txt; then
  echo '{"fix": false, "summary": "state.txt is current"}'
else
  echo '{"fix": true, "summary": "state.txt is stale"}'
fi
-- state.txt --
stale
