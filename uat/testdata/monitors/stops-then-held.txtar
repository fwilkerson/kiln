# A fix that can't pass stops, and waits for something to change.

env KILN_OPEN=true

# Given: a monitor whose check joins the gate, whose command leaves the check still asking for a fix, and that names
# no agent.
exec git rev-parse main
cp stdout $WORK/_given/main-before

# When: the developer runs kiln monitor run three times: once,
env KILN_NOW=2026-11-14T10:00:00Z
exec sh -c 'kiln monitor run || true'
grep -count=1 'ran' $WORK/_given/command.log

# Then: after the first run, main is unchanged and kiln status shows the fix stopped.
exec git rev-parse main
cmp stdout $WORK/_given/main-before
exec kiln status
stdout 'bump.*stopped'

# When: again with nothing changed,
env KILN_NOW=2026-11-14T11:00:00Z
exec sh -c 'kiln monitor run || true'

# Then: after the second, it shows the monitor held, and no fix ran.
exec kiln status
stdout 'bump.*held'
grep -count=1 'ran' $WORK/_given/command.log

# When: and again once a commit lands on main.
cp $WORK/_given/other.txt other.txt
exec git add other.txt
exec git commit -q -m 'land other work'
env KILN_NOW=2026-11-14T12:00:00Z
exec sh -c 'kiln monitor run || true'

# Then: the third run starts a fix.
grep -count=2 'ran' $WORK/_given/command.log

-- .kiln/kiln.json --
{"gate": ["true"], "monitors": [
 {"name": "bump", "every": "1h", "check": "sh .kiln/monitors/bump", "command": "sh .kiln/monitors/bump-command"}
]}
-- .kiln/monitors/bump --
if grep -qx current state.txt; then
  echo '{"fix": false, "summary": "state.txt is current"}'
else
  echo '{"fix": true, "summary": "state.txt is stale"}'
fi
-- .kiln/monitors/bump-command --
echo ran >>"$WORK/_given/command.log"
echo tried >>state.txt
-- state.txt --
stale
-- _given/command.log --
-- _given/main-before --
-- _given/other.txt --
other work
