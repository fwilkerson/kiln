# kiln init in a project that links whole folders of .claude/ to .kiln/ says nothing of the files they reach.

# Given: a project kiln init set up, whose .claude/ then links each folder rather than each file.
exec kiln init
exec rm -r .claude
mkdir .claude
symlink .claude/agents -> ../.kiln/agents
symlink .claude/skills -> ../.kiln/skills

# When: the developer runs kiln init again,
exec kiln init

# then it skips each link without a word, since each path already reaches kiln's own file.
! stdout 'linked nothing'
! stdout '^linked '
