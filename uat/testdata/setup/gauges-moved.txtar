# A kiln.json that still names gauges is refused, with where they moved, and a monitor that holds a gauge alone takes
# their place.

# Given: a project whose kiln.json names a gauge, as kiln once read one there.

# When: the developer runs kiln doctor,
! exec kiln doctor

# then it refuses kiln.json's gauges, and says where they moved.
stdout '^\.kiln/kiln\.json holds "gauges", a key kiln no longer reads: each gauge is a monitor now, \.kiln/monitors/<name>/ with its gauge script, and its line in monitor\.json: move each there, as kiln help gauges shows$'

# When: the developer moves the gauge into a monitor's directory, with its line and mustAccept, a key that steers a fix,
# and runs kiln doctor again,
exec perl -0pi -e 's/"gauges":\s*\[[^\]]*\]\s*,?\s*//; s/,\s*\}/}/' .kiln/kiln.json
mkdir .kiln/monitors/size
cp $WORK/_given/size .kiln/monitors/size/gauge
chmod 755 .kiln/monitors/size/gauge
cp $WORK/_given/accept.json .kiln/monitors/size/monitor.json
! exec kiln doctor

# then it refuses mustAccept, since the monitor fixes nothing, and names the fix.
! stdout 'holds "gauges"'
stdout '^\.kiln/monitors/size/ names mustAccept in its monitor\.json, a key that steers a fix, but holds no command and no agent\.md to fix with: drop mustAccept, or add a command or an agent\.md$'

# When: the developer drops mustAccept, and runs kiln doctor again,
cp $WORK/_given/line.json .kiln/monitors/size/monitor.json
! exec kiln doctor

# then it names no problem in the monitor.
! stdout 'monitors/size'

# When: the developer commits the monitor, and kiln monitor run runs it,
exec git add -A
exec git commit --quiet --no-verify -m 'chore: move the gauge to a monitor'
exec kiln monitor run size

# then the gauge reads on its line, and kiln status shows the monitor healthy, with its reading.
stdout '^size: healthy: size: 1, line ≤ 100$'
exec kiln status
stdout '^size: healthy'
stdout '^  size: 1, line ≤ 100$'

-- .kiln/kiln.json --
{"gauges": [{"name": "size", "command": ".kiln/gauges/size", "max": 100}]}
-- _given/size --
#!/bin/sh
echo 1
-- _given/accept.json --
{"atMost": 100, "mustAccept": true}
-- _given/line.json --
{"atMost": 100}
