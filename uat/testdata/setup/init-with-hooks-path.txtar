# kiln init writes no hook into a hooks directory that core.hooksPath names, shared or the repository's own, nor
# over the developer's own pre-commit hook.

# Given: a global core.hooksPath, to a directory outside the repository, with no pre-commit hook.
mkdir $WORK-hooks
exec git config --global core.hooksPath $WORK-hooks

# When: the developer runs kiln init,
exec kiln init

# then it writes its files and no hook, and says last why it installed none, and the line to add.
exists .kiln/kiln.json
! exists $WORK-hooks/pre-commit
! exists .git/hooks/pre-commit
! stdout '^installed /'
stdout '\ninstalled no pre-commit hook, since core\.hooksPath names .*-hooks, which other repositories may share; add this line to your own pre-commit hook: kiln precommit\n\z'

# Given: a repository whose own config names a hooks directory inside it, as husky does, and no branch main.
exec git branch -m master
exec git config core.hooksPath .githooks

# When: the developer runs kiln init again,
exec kiln init

# then it writes no hook there, says the directory is the repository's own, and still says last the line to add.
! exists .githooks/pre-commit
! stdout 'other repositories'
stdout '\ninstalled no pre-commit hook, since core\.hooksPath names \.githooks, this repository''s own hooks directory; add this line to your own pre-commit hook: kiln precommit\n\z'

# Having written no file this time, it names the gate but asks for no commit.
stdout '^the pre-commit hook runs the gate on each commit to main:$'
stdout '^  go vet \./\.\.\.$'
! stdout 'commit \.kiln/'

# Given: no core.hooksPath, and a pre-commit hook of the developer's own, as husky writes.
exec git config --global --unset core.hooksPath
exec git config --unset core.hooksPath
exec sh -c 'printf "#!/bin/sh\nexit 0\n" >.git/hooks/pre-commit && chmod +x .git/hooks/pre-commit'

# When: the developer runs kiln init again,
exec kiln init

# then it leaves the hook as it was, and says last why it installed none, and the line to add to it.
! grep 'kiln' .git/hooks/pre-commit
! stdout '^installed /'
stdout '\ninstalled no pre-commit hook, since .*/\.git/hooks/pre-commit is another one; add this line to it: kiln precommit\n\z'

