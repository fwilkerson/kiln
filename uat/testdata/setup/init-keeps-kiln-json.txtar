# kiln init adds $schema and rounds to a kiln.json that lacks them, and keeps each byte the developer wrote.

# Given: a repository whose .kiln/kiln.json, written by hand, lacks $schema and rounds.
# The file is copied in, since the harness adds rounds to a .kiln/kiln.json the script brings.
mkdir .kiln
cp _given/kiln.json .kiln/kiln.json

# When: the developer runs kiln init.
exec kiln init

# Then: kiln.json holds $schema and rounds as its last keys, indented as the key above them, and nothing else changed,
stdout '^wrote \.kiln/kiln\.json$'
cmp .kiln/kiln.json _given/want.json

# and a second run leaves the file as it is.
exec kiln init
! stdout 'kiln\.json'
cmp .kiln/kiln.json _given/want.json

-- _given/kiln.json --
{"gate": ["true"],
 "allowedHosts": ["a.example"],
 "acceptanceTests": "acc/{spec}/"}
-- _given/want.json --
{"gate": ["true"],
 "allowedHosts": ["a.example"],
 "acceptanceTests": "acc/{spec}/",
 "$schema": "./kiln.schema.json",
 "rounds": 3}
-- go.mod --
module example.com/scratch

go 1.27
