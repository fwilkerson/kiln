# 5. A project names its own hosts and paths.

# Given: a project whose .kiln/kiln.json on main names a host, and a command that prints a writable path.
# When: the developer queues a spec and runs kiln.
exec kiln queue x
exec kiln fire
stdout '^x: landed on main'

# Then: each session may reach that host and write that path, and reaches no host the file does not name.
grep '"allowedDomains": \[\s*"example\.org"\s*\]' .claude-calls/build/1/1/settings.json
grep '"allowWrite": \[\s*"/tmp/kiln-writable/build"\s*\]' .claude-calls/build/1/1/settings.json
grep '"allowedDomains": \[\s*"example\.org"\s*\]' .claude-calls/audit/1/1/settings.json
grep '"allowWrite": \[\s*"/tmp/kiln-writable/build"\s*\]' .claude-calls/audit/1/1/settings.json

-- .kiln/kiln.json --
{"allowedHosts": ["example.org"],
  "writablePathCommands": ["echo /tmp/kiln-writable/build"]
}
-- claude.json --
{
  "build": {"1": {"1": [
    {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
    {"result": {"result": "Built x."}}
  ]}},
  "audit": {"1": {"1": [{"result": {"result": "read 2 packages, found 0, reported 0"}}]}}
}
-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- _given/x/x.go --
// Package scratch is where kiln's builds land.
package scratch

// X answers 42.
func X() int { return 42 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
