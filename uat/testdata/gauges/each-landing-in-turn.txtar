# 6. Each gauge reads every landing in turn.

# Given: two monitors each hold a gauge, and two specs are queued.
exec kiln queue a
exec kiln queue b

# When: kiln fire lands both.
exec kiln fire
stdout '^a: landed on main'
stdout '^b: landed on main'

# Then: kiln fire's output shows both gauges' readings after each landing, before the next spec's build starts.
stdout '(?s)a: landed on main.*\na: gauge one: 1, line ≥ 0\na: gauge two: 2, line ≤ 5\nb: building on .*b: landed on main.*\nb: gauge one: 1, line ≥ 0\nb: gauge two: 2, line ≤ 5\n'

-- .kiln/kiln.json --
{"gate": ["test -e ready"]}
-- .kiln/monitors/one/gauge --
echo 1
-- .kiln/monitors/one/monitor.json --
{"atLeast": 0}
-- .kiln/monitors/two/gauge --
echo 2
-- .kiln/monitors/two/monitor.json --
{"atMost": 5}
-- .kiln/specs/a.md --
### 1. A is ready

- **Given**: nothing.
- **When**: the gate runs.
- **Then**: ready is there.
-- .kiln/specs/b.md --
### 1. B is ready

- **Given**: nothing.
- **When**: the gate runs.
- **Then**: ready is there.
