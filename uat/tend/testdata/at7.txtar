# A stopped build goes on in its own session, with what the developer decided.

# Given: an approved spec whose build stopped, its gate still failing after its last round, on a failure that a commit
# on main ends. The build's X answers Base + 1, and main's Base is 40, so X answers 41 where its test wants 42.
exec kiln queue x
exec kiln fire
stdout '^x: stopped'

# When: the developer runs kiln tend with the spec's name. The session makes that commit on main, setting Base to 41,
# leaves a note for the build, and exits.
exec sh -c 'kiln tend x >.tmp/tend.out 2>&1 || true'
exists .claude-calls/tend/1/1/call.json
exec git log -1 --format=%s main -- base.go
stdout '^fix: set Base to 41$'

# Then: kiln starts no new build.
! exists .claude-calls/build/2

# It resumes the build's session, with a message that holds the note.
grep '"resume": ?true' .claude-calls/build/1/3/call.json
grep 'Keep X as Base \+ 1: the developer set Base to 41 on main\.' .claude-calls/build/1/3/prompt

# The work lands on main, with the session's earlier work in it,
exec git show main:x.go
stdout 'return Base \+ 1'
exec git show main:acceptance/x/x_test.go
stdout 'want 42'
exec git show main:base.go
stdout 'Base = 41'

# and the spec waits for UAT.
exec kiln status
stdout '^x: waiting for UAT$'

-- .kiln/specs/x.md --
### 1. X answers

- **Given**: nothing.
- **When**: X is called.
- **Then**: it answers 42.
-- base.go --
// Package scratch is where kiln's builds land.
package scratch

// Base is what X builds on.
const Base = 40
-- _given/base.go --
// Package scratch is where kiln's builds land.
package scratch

// Base is what X builds on.
const Base = 41
-- claude.json --
{
 "build": {"1": {
  "1": [
   {"tool": {"name": "Bash", "input": {"command": "cp -R \"$WORK/_given/x/.\" ."}}},
   {"result": {"result": "Built x."}}
  ],
  "2": [{"result": {"result": "X answers Base + 1, and Base is 40 on main, which I may not change."}}],
  "3": [{"result": {"result": "Went on, as the developer said."}}]
 }},
 "audit": {"1": {"1": [{"result": {"result": "read 2 directories, found 0, reported 0"}}]}},
 "tend": {"1": {"1": [
  {"tool": {"name": "Bash", "input": {"command": "cp \"$WORK/_given/base.go\" base.go && git add base.go && git commit -q -m 'fix: set Base to 41'"}}},
  {"tool": {"name": "Bash", "input": {"command": "note=$(sed -n 's/^A note for the build: //p' \"$WORK/.claude-calls/tend/1/1/prompt\") && test -n \"$note\" && echo 'Keep X as Base + 1: the developer set Base to 41 on main.' >\"$note\""}}},
  {"exit": 0}
 ]}}
}
-- _given/x/x.go --
package scratch

// X answers one more than Base.
func X() int { return Base + 1 }
-- _given/x/acceptance/x/x_test.go --
package x_test

import (
	"testing"

	"example.com/scratch"
)

func TestAT1(t *testing.T) {
	if got := scratch.X(); got != 42 {
		t.Fatalf("X answers %d, want 42", got)
	}
}
