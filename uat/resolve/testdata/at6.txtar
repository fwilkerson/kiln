# 6. The landing's commit names what the session changed.

# Given: a fix as in test 1, which changed two files, doc.txt and extra.txt. Main changed one of them since.
exec sh -c 'kiln monitor run || true'
exec kiln status
stdout 'stale.*waiting'
exec sh -c 'printf "title\nstale, by hand\n" >doc.txt && git commit -qam "docs: edit by hand"'

# When: the fix lands, after its session merged main.
exec kiln accept stale
exec git show main:extra.txt
stdout '^extra, fixed$'

# Then: the commit that moved main names the file the session changed, and not the file that lands as the developer
# accepted it.
exec git log -1 --format=%b main
stdout '^Changed since kiln accept: doc\.txt$'

-- .kiln/kiln.json --
{"gate": ["true"], "rounds": 3, "monitors": [
 {"name": "stale", "every": "24h", "check": "sh .kiln/monitors/stale", "agent": ".kiln/agents/stale.md", "prompt": "Mark the doc fixed.", "accept": true}
]}
-- .kiln/monitors/stale --
if grep -q fixed doc.txt; then
  echo '{"fix": false, "summary": "doc.txt is fixed"}'
else
  echo '{"fix": true, "summary": "doc.txt is stale"}'
fi
-- .kiln/agents/stale.md --
Mark the doc fixed.
-- doc.txt --
title
stale
-- extra.txt --
extra
-- claude.json --
{
 "stale": {"1": {
  "1": [
   {"tool": {"name": "Bash", "input": {"command": "printf 'title\\nfixed\\n' >doc.txt && echo 'extra, fixed' >extra.txt"}}},
   {"result": {"result": "Marked the doc fixed.\n{\"title\": \"fix(doc): mark the doc fixed\"}"}}
  ],
  "2": [
   {"tool": {"name": "Bash", "input": {"command": "git merge main; printf 'title\\nfixed, by hand\\n' >doc.txt && git add doc.txt && git commit -q --no-edit"}}},
   {"result": {"result": "Merged main, keeping both lines' changes."}}
  ]
 }},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "2": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
 }
}
