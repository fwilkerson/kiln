# 5. kiln status shows the session at work on a landing.

env KILN_OPEN=true

# Given: a fix as in test 1.
exec sh -c 'kiln monitor run || true'
exec kiln status
stdout 'stale.*waiting'
exec sh -c 'printf "title\nstale, by hand\n" >doc.txt && git commit -qam "docs: edit by hand"'

# When: kiln status runs while the fix's session merges main. The session waits for .tmp/go-on before it merges.
exec kiln accept stale &
exec await .tmp/merging
exec kiln status

# Then: it shows the monitor's fix landing, and that its session is at work on a conflict with main.
stdout 'stale: accepted, landing: conflict with main, round 1 of 3'

exec touch .tmp/go-on
wait

-- .kiln/kiln.json --
{"gate": ["true"], "rounds": 3, "monitors": [
 {"name": "stale", "every": "24h", "check": "sh .kiln/monitors/stale", "agent": ".kiln/agents/stale.md", "prompt": "Mark the doc fixed.", "accept": true}
]}
-- .kiln/monitors/stale --
if grep -q fixed doc.txt; then
  echo '{"fix": false, "summary": "doc.txt is fixed"}'
else
  echo '{"fix": true, "summary": "doc.txt is stale"}'
fi
-- .kiln/agents/stale.md --
Mark the doc fixed.
-- doc.txt --
title
stale
-- claude.json --
{
 "stale": {"1": {
  "1": [
   {"tool": {"name": "Bash", "input": {"command": "printf 'title\\nfixed\\n' >doc.txt"}}},
   {"result": {"result": "Marked the doc fixed.\n{\"title\": \"fix(doc): mark the doc fixed\"}"}}
  ],
  "2": [
   {"tool": {"name": "Bash", "input": {"command": "touch \"$WORK/.tmp/merging\"; await \"$WORK/.tmp/go-on\"; git merge main; printf 'title\\nfixed, by hand\\n' >doc.txt && git add doc.txt && git commit -q --no-edit"}}},
   {"result": {"result": "Merged main, keeping both lines' changes."}}
  ]
 }},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "2": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
 }
}
