# 1. An accepted fix that conflicts with main lands.

env KILN_OPEN=true

# Given: a monitor whose fixes wait for kiln accept, and a fix its agent made, waiting on its branch.
exec sh -c 'kiln monitor run || true'
exec kiln status
stdout 'stale.*waiting'

# Main changed since, in a line the fix changed.
exec sh -c 'printf "title\nstale, by hand\n" >doc.txt && git commit -qam "docs: edit by hand"'

# When: the developer runs kiln accept with the monitor's name, and the fix's session merges main.
exec kiln accept stale

# Then: kiln resumes the session that made the fix, and tells it each file in conflict.
! exists .claude-calls/fix/2
grep '"resume": ?true' .claude-calls/fix/1/2/call.json
grep 'doc\.txt' .claude-calls/fix/1/2/prompt
grep 'git merge main' .claude-calls/fix/1/2/prompt

# After the gate passes, main holds both main's change and the fix's.
exec git show main:doc.txt
stdout 'by hand'
stdout 'fixed'

-- .kiln/kiln.json --
{"gate": ["true"], "rounds": 3}
-- .kiln/monitors/stale/check --
if grep -q fixed doc.txt; then
  echo '{"fix": false, "summary": "doc.txt is fixed"}'
else
  echo '{"fix": true, "summary": "doc.txt is stale"}'
fi
-- .kiln/monitors/stale/agent.md --
Mark the doc fixed.

Mark the doc fixed.
-- .kiln/monitors/stale/monitor.json --
{"accept": true}
-- doc.txt --
title
stale
-- claude.json --
{
 "fix": {"1": {
  "1": [
   {"tool": {"name": "Bash", "input": {"command": "printf 'title\\nfixed\\n' >doc.txt"}}},
   {"result": {"result": "Marked the doc fixed.\n{\"title\": \"fix(doc): mark the doc fixed\"}"}}
  ],
  "2": [
   {"tool": {"name": "Bash", "input": {"command": "git merge main; printf 'title\\nfixed, by hand\\n' >doc.txt && git add doc.txt && git commit -q --no-edit"}}},
   {"result": {"result": "Merged main, keeping both lines' changes."}}
  ]
 }},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "2": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
 }
}
