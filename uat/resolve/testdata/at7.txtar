# 7. The audit reads what the session changed.

env KILN_OPEN=true

# Given: a fix as in test 6.
exec sh -c 'kiln monitor run || true'
exec kiln status
stdout 'stale.*waiting'
exec sh -c 'printf "title\nstale, by hand\n" >doc.txt && git commit -qam "docs: edit by hand"'
exec git rev-parse main
cp stdout .tmp/main-before

# When: the fix's session merges main, and the gate passes.
exec kiln accept stale

# Then: before main moves, the audit runs, and kiln tells it the file the session changed.
grep 'doc\.txt' .claude-calls/audit/2/1/prompt

# The audit's findings go back to the fix's session. When the session answers them, main has not moved yet.
grep 'doc\.txt:2 drops the title' .claude-calls/stale/1/3/prompt
cmp .tmp/main-at-answer .tmp/main-before

-- .kiln/kiln.json --
{"gate": ["true"], "rounds": 3, "monitors": [
 {"name": "stale", "every": "24h", "check": "sh .kiln/monitors/stale", "agent": ".kiln/agents/stale.md", "prompt": "Mark the doc fixed.", "accept": true}
]}
-- .kiln/monitors/stale --
if grep -q fixed doc.txt; then
  echo '{"fix": false, "summary": "doc.txt is fixed"}'
else
  echo '{"fix": true, "summary": "doc.txt is stale"}'
fi
-- .kiln/agents/stale.md --
Mark the doc fixed.
-- doc.txt --
title
stale
-- extra.txt --
extra
-- claude.json --
{
 "stale": {"1": {
  "1": [
   {"tool": {"name": "Bash", "input": {"command": "printf 'title\\nfixed\\n' >doc.txt && echo 'extra, fixed' >extra.txt"}}},
   {"result": {"result": "Marked the doc fixed.\n{\"title\": \"fix(doc): mark the doc fixed\"}"}}
  ],
  "2": [
   {"tool": {"name": "Bash", "input": {"command": "git merge main; printf 'title\\nfixed, by hand\\n' >doc.txt && git add doc.txt && git commit -q --no-edit"}}},
   {"result": {"result": "Merged main, keeping both lines' changes."}}
  ],
  "3": [
   {"tool": {"name": "Bash", "input": {"command": "git rev-parse main >\"$WORK/.tmp/main-at-answer\""}}},
   {"result": {"result": "The title is still on line 1, so the finding is wrong."}}
  ]
 }},
 "audit": {
  "1": {"1": [{"result": {"result": "read 1 directories, found 0"}}]},
  "2": {"1": [{"result": {"result": "1. doc.txt:2 drops the title\n\nread 1 directories, found 1"}}]},
  "3": {"1": [{"result": {"result": "read 1 directories, found 0"}}]}
 }
}
