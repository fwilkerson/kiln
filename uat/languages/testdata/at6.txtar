# 6. A build that changes a Python file and the README gets an audit of the directories it changed.

# Given: an approved spec whose build changes app/models.py and README.md.

# When: the build's gate passes.
exec kiln queue t
exec kiln fire
stdout '^t: landed on main'

# Then: the audit runs, and it is told to read app and . and no other directory.
exists .claude-calls/audit/1/1/prompt
grep '^Audit these directories: `\.`, `app`\. ' .claude-calls/audit/1/1/prompt

-- .kiln/kiln.json --
{"gate": ["true"]}
-- .kiln/specs/t.md --
### 1. T is built

- **Given**: nothing.
- **When**: the gate runs.
- **Then**: the work is there.
-- README.md --
# t
-- app/models.py --
NAME = "t"
-- tests/test_models.py --
from app.models import NAME


def test_name():
    assert NAME == "t"
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "echo 'SIZE = 1' >>app/models.py && echo Models. >>README.md"
      }
     }
    },
    {
     "result": {
      "result": "Built t."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "result": "read 1 directories, found 0"
     }
    }
   ]
  }
 }
}
