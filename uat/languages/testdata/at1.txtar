# 1. A pytest test that fails on main too does not block a build.

# Given: a project whose gate command reports test test_a failed, both on the build's commit and on main.
# The gate command copies pytest's JUnit XML, where test_a failed and test_b passed, to $KILN_JUNIT, and exits 1.

# When: a build of an approved spec reaches the gate.
exec kiln queue t
exec kiln fire

# Then: the gate passes, and the build lands.
stdout '^t: landed on main'
! stdout 'failing:'
exec git show main:work.txt
stdout '^work$'

-- .kiln/kiln.json --
{"gate": ["if [ \"$(git rev-parse HEAD)\" = \"$(git rev-parse main)\" ]; then cp _junit/main.xml \"$KILN_JUNIT\"; else cp _junit/build.xml \"$KILN_JUNIT\"; fi; exit 1"]}
-- .kiln/specs/t.md --
### 1. T is built

- **Given**: nothing.
- **When**: the gate runs.
- **Then**: the work is there.
-- _junit/main.xml --
<?xml version="1.0" encoding="utf-8"?>
<!-- Written by pytest 9.2.0 under uv 0.13.7: test_a fails, test_b passes. -->
<testsuites name="pytest tests"><testsuite name="pytest" errors="0" failures="1" skipped="0" tests="2" time="0.010" timestamp="2026-11-11T23:35:28.212216-05:00" hostname="localhost"><testcase classname="tests.test_x" name="test_a" time="0.000"><failure message="assert False">def test_a():
&gt;       assert False
E       assert False

tests/test_x.py:2: AssertionError</failure></testcase><testcase classname="tests.test_x" name="test_b" time="0.000" /></testsuite></testsuites>
-- _junit/build.xml --
<?xml version="1.0" encoding="utf-8"?>
<!-- Written by pytest 9.2.0 under uv 0.13.7: test_a fails, test_b passes. -->
<testsuites name="pytest tests"><testsuite name="pytest" errors="0" failures="1" skipped="0" tests="2" time="0.010" timestamp="2026-11-11T23:35:28.212216-05:00" hostname="localhost"><testcase classname="tests.test_x" name="test_a" time="0.000"><failure message="assert False">def test_a():
&gt;       assert False
E       assert False

tests/test_x.py:2: AssertionError</failure></testcase><testcase classname="tests.test_x" name="test_b" time="0.000" /></testsuite></testsuites>
-- claude.json --
{
 "build": {
  "1": {
   "1": [
    {
     "tool": {
      "name": "Bash",
      "input": {
       "command": "echo work >work.txt"
      }
     }
    },
    {
     "result": {
      "result": "Built t."
     }
    }
   ]
  }
 },
 "audit": {
  "1": {
   "1": [
    {
     "result": {
      "result": "read 1 directories, found 0"
     }
    }
   ]
  }
 }
}
