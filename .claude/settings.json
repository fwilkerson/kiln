{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|REPL|mcp__goland__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go tool agentcheck",
            "statusMessage": "Checking the Go files the call changed"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|Bash|REPL|mcp__goland__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go tool agentcheck",
            "statusMessage": "Checking the Go files the call changed"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|REPL|mcp__goland__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go tool agentcheck"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && go tool agentcheck",
            "statusMessage": "Checking the repository's Go files"
          }
        ]
      }
    ]
  }
}
